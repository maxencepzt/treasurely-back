# Image unique pour Vercel Functions (runtime conteneur) : FrankenPHP sert l'API, la
# façade concepteur et l'administration sur $PORT. La base de données, les clés JWT
# (contenu PEM dans JWT_SECRET_KEY et JWT_PUBLIC_KEY) et les secrets arrivent par
# variables d'environnement. Les migrations se lancent depuis un poste avec la
# DATABASE_URL de production, jamais au démarrage du conteneur.
FROM dunglas/frankenphp:1-php8.4-alpine

RUN set -eux; install-php-extensions apcu intl opcache pdo_pgsql zip; \
    cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini"
COPY docker/php/conf.d/config.ini $PHP_INI_DIR/conf.d/config.ini
COPY docker/frankenphp/Caddyfile /etc/caddy/Caddyfile
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

ENV APP_ENV=prod COMPOSER_ALLOW_SUPERUSER=1 PORT=80
WORKDIR /app

COPY composer.json composer.lock symfony.lock ./
RUN set -eux; composer install --prefer-dist --no-dev --no-scripts --no-progress; \
    composer clear-cache

COPY .env importmap.php ./
COPY assets/ assets/
COPY bin/ bin/
COPY config/ config/
COPY migrations/ migrations/
COPY public/ public/
COPY src/ src/
COPY templates/ templates/
RUN set -eux; composer dump-autoload --classmap-authoritative --no-dev; \
    composer run-script --no-dev post-install-cmd; \
    bin/console tailwind:build --minify; \
    bin/console asset-map:compile

CMD ["frankenphp", "run", "--config", "/etc/caddy/Caddyfile"]
