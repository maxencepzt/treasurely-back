{# Modal de saisie d'une énigme, piloté par riddle-manager.js. Les champs n'ont pas de
   name : ils ne sont jamais soumis tels quels, le script en construit la charge utile. #}
{% import 'designer/_partials/macros.html.twig' as ui %}
{% import 'designer/_partials/icons.html.twig' as icons %}

<div id="riddle_modal" class="hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4" role="dialog" aria-modal="true" aria-labelledby="riddle_modal_title">
    <div class="bg-white rounded-2xl border border-slate-200 shadow-xl max-w-3xl w-full max-h-[90vh] overflow-y-auto">
        <div class="sticky top-0 bg-white border-b border-slate-200 px-6 py-4 flex items-center justify-between rounded-t-2xl z-10">
            <div class="flex items-center gap-3">
                {{ ui.badge(icons.path('riddle'), 'bg-purple-100 text-purple-600') }}
                <h3 id="riddle_modal_title" class="text-xl font-bold text-slate-800">Ajouter une énigme</h3>
            </div>
            <button type="button" id="close_riddle_modal" class="w-10 h-10 rounded-xl flex items-center justify-center text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-500" aria-label="Fermer">
                {{ ui.icon(icons.path('close'), 'w-6 h-6') }}
            </button>
        </div>

        <form id="riddle_form" class="p-6 space-y-6" onsubmit="return false;">
            <div class="space-y-5">
                <div>
                    {{ ui.label('riddle_title', 'Titre de l\'énigme', true) }}
                    <input type="text" id="riddle_title" required maxlength="20" placeholder="Ex : Trouve le monument" class="{{ ui.input() }}" />
                    <p class="mt-1 text-sm text-slate-500">20 caractères maximum.</p>
                </div>
                <div>
                    {{ ui.label('riddle_description', 'Énoncé', true) }}
                    <textarea id="riddle_description" required maxlength="1000" rows="4" placeholder="Décrivez l'énigme que les joueurs devront résoudre…" class="{{ ui.textarea() }}"></textarea>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div>
                        {{ ui.label('riddle_type', 'Type', true) }}
                        <select id="riddle_type" required class="{{ ui.input('cursor-pointer') }}">
                            <option value="text">Réponse texte</option>
                            <option value="gps">Localisation GPS</option>
                            <option value="mcq">QCM</option>
                            <option value="qr">QR Code</option>
                        </select>
                    </div>
                    <div>
                        {{ ui.label('riddle_difficulty', 'Difficulté', true) }}
                        <select id="riddle_difficulty" required class="{{ ui.input('cursor-pointer') }}">
                            <option value="1">Facile</option>
                            <option value="2" selected>Moyen</option>
                            <option value="3">Difficile</option>
                        </select>
                    </div>
                    <div>
                        {{ ui.label('riddle_max_attempts', 'Essais notés', true) }}
                        <input type="number" id="riddle_max_attempts" required min="1" max="20" step="1" value="3" class="{{ ui.input() }}" />
                        <p class="mt-1 text-xs text-slate-500">De 1 à 20. Au-delà, le joueur répond encore mais ne marque plus.</p>
                    </div>
                </div>
            </div>

            {# Un panneau par type, teinté comme l'énigme dans la liste. #}
            <div id="text_fields" class="riddle-type-fields">
                <div class="bg-blue-50 border border-blue-100 rounded-xl p-4">
                    {{ ui.label('text_answer', 'Réponse attendue', true) }}
                    <input type="text" id="text_answer" maxlength="100" placeholder="La réponse correcte" class="{{ ui.input() }}" />
                    <p class="mt-2 text-sm text-slate-500">La comparaison ignore la casse, les accents et les espaces superflus.</p>
                </div>
            </div>

            <div id="gps_fields" class="riddle-type-fields hidden">
                <div class="bg-green-50 border border-green-100 rounded-xl p-4">
                    <p class="text-sm font-semibold text-slate-700 mb-3">Coordonnées de la cible <span class="text-red-500" aria-hidden="true">*</span></p>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label for="gps_latitude" class="block text-sm font-medium text-slate-700 mb-1">Latitude</label>
                            <input type="number" id="gps_latitude" step="0.000001" min="-90" max="90" placeholder="49.253700" class="{{ ui.input() }}" />
                        </div>
                        <div>
                            <label for="gps_longitude" class="block text-sm font-medium text-slate-700 mb-1">Longitude</label>
                            <input type="number" id="gps_longitude" step="0.000001" min="-180" max="180" placeholder="4.034000" class="{{ ui.input() }}" />
                        </div>
                    </div>
                    <p class="mt-2 text-sm text-slate-500">Le joueur valide l'énigme à moins de 50 mètres de ce point.</p>
                </div>
            </div>

            <div id="mcq_fields" class="riddle-type-fields hidden">
                <div class="bg-purple-50 border border-purple-100 rounded-xl p-4">
                    <div class="flex items-center justify-between gap-3 mb-2">
                        <p class="text-sm font-semibold text-slate-700">Choix proposés <span class="text-red-500" aria-hidden="true">*</span></p>
                        <button type="button" id="add_mcq_choice" class="{{ ui.btn('secondary', 'sm') }}">
                            {{ ui.icon(icons.path('plus'), 'w-4 h-4') }}
                            <span>Ajouter un choix</span>
                        </button>
                    </div>
                    <p class="text-sm text-slate-500 mb-3">Cochez la ou les bonnes réponses. Plus il y a de choix, moins l'énigme se devine.</p>
                    <div id="mcq_choices_container" class="space-y-2"></div>
                    <label class="mt-4 flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" id="mcq_reveal_count" checked class="w-5 h-5 accent-green-600" />
                        <span class="text-sm text-slate-700">Annoncer au joueur le nombre de bonnes réponses attendues</span>
                    </label>
                </div>
            </div>

            <div id="qr_fields" class="riddle-type-fields hidden">
                <div class="bg-orange-50 border border-orange-100 rounded-xl p-4">
                    <p class="text-sm font-semibold text-slate-700 mb-2">Code du QR</p>
                    <p id="qr_code_display" class="font-mono text-lg text-orange-800">Attribué à l'enregistrement</p>
                    <p class="mt-2 text-sm text-slate-500">Le serveur attribue un code de la forme <code>treasurely_</code> suivi de neuf chiffres, qui ne change plus ensuite. Le QR à imprimer est proposé sur la page de détails de la chasse.</p>
                </div>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-200">
                <button type="button" id="close_riddle_modal_btn" class="{{ ui.btn('ghost') }}">Annuler</button>
                <button type="button" id="save_riddle_btn" class="{{ ui.btn('primary') }}">
                    {{ ui.icon(icons.path('check_plain')) }}
                    <span>Enregistrer l'énigme</span>
                </button>
            </div>
        </form>
    </div>
</div>
