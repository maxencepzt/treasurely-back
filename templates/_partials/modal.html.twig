{#
    Modal global réutilisable et personnalisable

    Paramètres:
    - id: Identifiant unique du modal (par défaut: 'globalModal')
#}

{% set modalId = id|default('globalModal') %}

<!-- Modal Container -->
<div id="{{ modalId }}" class="modal-container hidden fixed inset-0 bg-emerald-100 z-50 flex items-center justify-center p-4" data-modal="{{ modalId }}">
    <div class="modal-content bg-white rounded-2xl shadow-2xl max-w-md w-full transform transition-all">
        <div class="p-6">
            <!-- Icône -->
            <div class="modal-icon-container w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="modal-icon w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <!-- L'icône sera injectée par JavaScript -->
                </svg>
            </div>

            <!-- Titre -->
            <h3 class="modal-title text-xl font-bold text-gray-900 text-center mb-2"></h3>

            <!-- Message -->
            <div class="modal-message text-gray-600 text-center mb-2"></div>

            <!-- Message d'avertissement optionnel -->
            <p class="modal-warning text-sm text-center mb-6 hidden"></p>

            <!-- Boutons -->
            <div class="modal-buttons flex space-x-3">
                <button class="modal-cancel flex-1 px-4 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-xl transition">
                    Annuler
                </button>
                <button class="modal-confirm flex-1 px-4 py-3 font-semibold rounded-xl transition flex items-center justify-center space-x-2">
                    <svg class="modal-confirm-icon w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <!-- L'icône sera injectée par JavaScript -->
                    </svg>
                    <span class="modal-confirm-text">Confirmer</span>
                </button>
            </div>
        </div>
    </div>
</div>

