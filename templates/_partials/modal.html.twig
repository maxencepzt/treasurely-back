{#
    Modal global réutilisable et personnalisable

    Paramètres:
    - id: Identifiant unique du modal (par défaut: 'globalModal')
#}

{% set modalId = id|default('globalModal') %}

<!-- Modal Container -->
<div id="{{ modalId }}" class="modal-container hidden fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-50 flex items-center justify-center p-4" data-modal="{{ modalId }}" role="dialog" aria-modal="true">
    <div class="modal-content bg-white rounded-2xl border border-slate-200 shadow-xl max-w-md w-full transform transition-all">
        <div class="p-6">
            <!-- Icône -->
            <div class="modal-icon-container w-16 h-16 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="modal-icon w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <!-- L'icône sera injectée par JavaScript -->
                </svg>
            </div>

            <!-- Titre -->
            <h3 class="modal-title text-xl font-bold text-slate-900 text-center mb-2"></h3>

            <!-- Message -->
            <div class="modal-message text-slate-600 text-center mb-2"></div>

            <!-- Message d'avertissement optionnel -->
            <p class="modal-warning text-sm text-center mb-6 hidden"></p>

            <!-- Boutons -->
            <div class="modal-buttons flex space-x-3">
                <button class="cursor-pointer modal-cancel flex-1 px-4 py-3 bg-white border border-slate-300 hover:bg-slate-50 text-slate-700 font-semibold rounded-xl transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-slate-400 focus-visible:ring-offset-2">
                    Annuler
                </button>
                <button class="cursor-pointer modal-confirm flex-1 px-4 py-3 font-semibold rounded-xl transition-colors flex items-center justify-center space-x-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-slate-400">
                    <svg class="modal-confirm-icon w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <!-- L'icône sera injectée par JavaScript -->
                    </svg>
                    <span class="modal-confirm-text">Confirmer</span>
                </button>
            </div>
        </div>
    </div>
</div>
