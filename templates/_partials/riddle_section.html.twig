{# Liste des énigmes d'une chasse.
   - riddles : tableaux produits par RiddleMapper::toArray(), identifiant compris
   - readonly : true pour la page de détails, false dans le formulaire
   En mode formulaire, riddle-manager.js relit data-riddle-data et redessine la liste. #}
{% import 'designer/_partials/macros.html.twig' as ui %}
{% set riddles = riddles|default([]) %}
{% set readonly = readonly|default(false) %}
{% set typeLabels = {text: 'Texte', gps: 'GPS', mcq: 'QCM', qr: 'QR Code'} %}

<div class="bg-white rounded-2xl shadow-lg p-6">
    <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-gray-800 flex items-center space-x-2">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>Énigmes (<span id="riddles_count">{{ riddles|length }}</span>)</span>
        </h2>
        {% if not readonly %}
            <button type="button" id="add_riddle_btn" class="bg-purple-600 hover:bg-purple-700 text-white font-semibold px-4 py-2 rounded-lg shadow transform transition hover:scale-105 flex items-center space-x-2 cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                <span>Ajouter une énigme</span>
            </button>
        {% endif %}
    </div>

    <div id="no_riddles_message" class="p-8 text-center bg-gray-50 rounded-xl border-2 border-dashed border-gray-200 {% if riddles|length > 0 %}hidden{% endif %}">
        <p class="text-gray-500 font-medium mb-2">Aucune énigme pour le moment</p>
        <p class="text-gray-400 text-sm">
            {% if readonly %}Cette chasse ne contient pas encore d'énigmes.{% else %}Cliquez sur « Ajouter une énigme » pour composer le parcours.{% endif %}
        </p>
    </div>

    <div id="riddles_list" class="space-y-3 {% if riddles|length == 0 %}hidden{% endif %}">
        {% for riddle in riddles %}
            <div class="riddle-item bg-gray-50 p-4 rounded-xl border border-gray-200"
                 data-riddle-index="{{ loop.index0 }}"
                 {% if not readonly %}data-riddle-data="{{ riddle|json_encode|e('html_attr') }}"{% endif %}>
                <div class="flex items-start justify-between">
                    <div class="flex items-start space-x-3 flex-1">
                        <div class="w-8 h-8 bg-purple-600 rounded-lg flex items-center justify-center text-white font-bold text-sm flex-shrink-0">{{ loop.index }}</div>
                        <div class="flex-1">
                            <h4 class="font-semibold text-gray-800">{{ riddle.title }}</h4>
                            <p class="text-sm text-gray-600 mt-1">{{ ui.excerpt(riddle.description, 100) }}</p>
                            <div class="flex items-center flex-wrap gap-x-3 gap-y-1 mt-2 text-xs text-gray-500">
                                <span class="bg-purple-100 text-purple-700 px-2 py-0.5 rounded">{{ typeLabels[riddle.type]|default(riddle.type) }}</span>
                                {{ ui.flames(riddle.difficulty) }}
                                <span>{{ riddle.maxScoringAttempts }} essai{{ riddle.maxScoringAttempts > 1 ? 's' }} noté{{ riddle.maxScoringAttempts > 1 ? 's' }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
