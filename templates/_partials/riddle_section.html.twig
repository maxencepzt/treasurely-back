{# Liste des énigmes d'une chasse.
   - riddles : tableaux produits par RiddleMapper::toArray(), identifiant compris
   - readonly : true pour la page de détails, false dans le formulaire
   - huntId : identifiant de la chasse, pour le QR à imprimer des énigmes QR (page de détails)
   En mode formulaire, riddle-manager.js relit data-riddle-data et redessine la liste. #}
{% import 'designer/_partials/macros.html.twig' as ui %}
{% import 'designer/_partials/icons.html.twig' as icons %}
{% set riddles = riddles|default([]) %}
{% set readonly = readonly|default(false) %}
{% set typeLabels = {text: 'Texte', gps: 'GPS', mcq: 'QCM', qr: 'QR Code'} %}
{# Même accent par type que riddle-manager.js, pour que la liste serveur et la liste JS se ressemblent. #}
{% set typeStyles = {
    text: {number: 'bg-blue-600', tag: 'bg-blue-50 text-blue-700', hover: 'hover:border-blue-300'},
    gps: {number: 'bg-green-600', tag: 'bg-green-50 text-green-700', hover: 'hover:border-green-300'},
    mcq: {number: 'bg-purple-600', tag: 'bg-purple-50 text-purple-700', hover: 'hover:border-purple-300'},
    qr: {number: 'bg-orange-600', tag: 'bg-orange-50 text-orange-700', hover: 'hover:border-orange-300'},
} %}

<div class="bg-white rounded-2xl border border-slate-200 shadow-sm p-6">
    <div class="flex items-center justify-between gap-4 mb-5">
        <div class="flex items-center gap-3">
            {{ ui.badge(icons.path('riddle'), 'bg-purple-100 text-purple-600') }}
            <h2 class="text-lg font-bold text-slate-800">Énigmes (<span id="riddles_count">{{ riddles|length }}</span>)</h2>
        </div>
        {% if not readonly %}
            <button type="button" id="add_riddle_btn" class="{{ ui.btn('purple', 'sm') }} shrink-0">
                {{ ui.icon(icons.path('plus'), 'w-4 h-4') }}
                <span>Ajouter une énigme</span>
            </button>
        {% endif %}
    </div>

    <div id="no_riddles_message" class="p-8 text-center bg-slate-50 rounded-xl border-2 border-dashed border-slate-200 {% if riddles|length > 0 %}hidden{% endif %}">
        <p class="text-slate-600 font-medium mb-1">Aucune énigme pour le moment</p>
        <p class="text-slate-400 text-sm">
            {% if readonly %}Cette chasse ne contient pas encore d'énigmes.{% else %}Cliquez sur « Ajouter une énigme » pour composer le parcours.{% endif %}
        </p>
    </div>

    <div id="riddles_list" class="space-y-3 {% if riddles|length == 0 %}hidden{% endif %}">
        {% for riddle in riddles %}
            {% set style = typeStyles[riddle.type]|default(typeStyles.text) %}
            <div class="riddle-item bg-white p-4 rounded-xl border border-slate-200 {{ style.hover }} hover:shadow-sm transition-all"
                 data-riddle-index="{{ loop.index0 }}"
                 {% if not readonly %}data-riddle-data="{{ riddle|json_encode|e('html_attr') }}"{% endif %}>
                <div class="flex items-start justify-between">
                    <div class="flex items-start space-x-3 flex-1">
                        <div class="w-8 h-8 {{ style.number }} rounded-lg flex items-center justify-center text-white font-bold text-sm tabular-nums flex-shrink-0">{{ loop.index }}</div>
                        <div class="flex-1 min-w-0">
                            <h4 class="font-semibold text-slate-800">{{ riddle.title }}</h4>
                            <p class="text-sm text-slate-600 mt-1">{{ ui.excerpt(riddle.description, 100) }}</p>
                            <div class="flex items-center flex-wrap gap-x-3 gap-y-1 mt-2 text-xs text-slate-500">
                                <span class="{{ style.tag }} px-2 py-0.5 rounded-md font-semibold">{{ typeLabels[riddle.type]|default(riddle.type) }}</span>
                                {{ ui.flames(riddle.difficulty) }}
                                <span>{{ riddle.maxScoringAttempts }} essai{{ riddle.maxScoringAttempts > 1 ? 's' }} noté{{ riddle.maxScoringAttempts > 1 ? 's' }}</span>
                            </div>
                            {% if readonly and riddle.type == 'qr' and huntId is defined %}
                                {% set qrPath = path('app_designer_riddle_qr', {id: huntId, riddle: riddle.id}) %}
                                <div class="mt-3 flex items-center gap-4 rounded-xl bg-slate-50 border border-slate-100 p-3">
                                    <img src="{{ qrPath }}" alt="QR code de l'énigme {{ riddle.title }}" class="w-24 h-24 rounded-lg border border-slate-200 bg-white" />
                                    <div class="text-sm space-y-1">
                                        <p class="font-mono text-slate-800">{{ riddle.code }}</p>
                                        <a href="{{ qrPath }}" target="_blank" class="inline-flex items-center gap-1 text-orange-700 font-semibold hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 rounded">
                                            Ouvrir le QR pour l'imprimer
                                            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                                        </a>
                                    </div>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
