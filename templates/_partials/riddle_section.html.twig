{# Section réutilisable pour afficher et gérer les énigmes #}
{# Variables attendues :
   - riddles: liste des énigmes (optionnel, peut être vide)
   - showAddButton: booléen pour afficher/masquer le bouton d'ajout (défaut: true)
   - readonly: booléen pour le mode lecture seule (défaut: false)
#}

{% set riddles = riddles|default([]) %}
{% set showAddButton = showAddButton|default(true) %}
{% set readonly = readonly|default(false) %}

<!-- Section : Énigmes -->
<div class="bg-white rounded-2xl shadow-lg p-6">
    <div class="flex items-center justify-between mb-6">
        <h2 class="text-xl font-bold text-gray-800 flex items-center space-x-2">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>Énigmes (<span id="riddles_count">{{ riddles|length }}</span>)</span>
        </h2>
        {% if showAddButton and not readonly %}
            <button type="button" id="add_riddle_btn" class="bg-purple-600 hover:bg-purple-700 text-white font-semibold px-4 py-2 rounded-lg shadow transform transition hover:scale-105 flex items-center space-x-2 cursor-pointer">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                </svg>
                <span>Ajouter une énigme</span>
            </button>
        {% endif %}
    </div>

    <!-- Message si aucune énigme -->
    <div id="no_riddles_message" class="p-8 text-center bg-gray-50 rounded-xl border-2 border-dashed border-gray-200 {% if riddles|length > 0 %}hidden{% endif %}">
        <svg class="w-16 h-16 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
        <p class="text-gray-500 font-medium mb-2">Aucune énigme pour le moment</p>
        <p class="text-gray-400 text-sm">
            {% if showAddButton and not readonly %}
                Cliquez sur "Ajouter une énigme" pour commencer à créer votre parcours
            {% else %}
                Cette chasse ne contient pas encore d'énigmes
            {% endif %}
        </p>
    </div>

    <!-- Liste des énigmes -->
    <div id="riddles_list" class="space-y-3 {% if riddles|length == 0 %}hidden{% endif %}">
        {% for riddle in riddles %}
            {% set typeLabels = {
                'text': 'Texte',
                'gps': 'GPS',
                'mcq': 'QCM',
                'qr': 'QR Code'
            } %}
            <div class="riddle-item bg-gray-50 p-4 rounded-xl border border-gray-200"
                 data-riddle-index="{{ loop.index0 }}"
                 data-riddle-data="{{ riddle|json_encode|e('html_attr') }}">
                <div class="flex items-start justify-between">
                    <div class="flex-1">
                        <h4 class="font-semibold text-gray-800">{{ riddle.title }}</h4>
                        <p class="text-sm text-gray-600 mt-1">{{ riddle.description|slice(0, 100) }}{% if riddle.description|length > 100 %}...{% endif %}</p>
                        <div class="flex items-center space-x-3 mt-2 text-xs text-gray-500">
                            <span class="flex items-center">
                                <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                                </svg>
                                Difficulté: {{ riddle.difficulty }}
                            </span>
                            <span>Type: {{ typeLabels[riddle.type]|default('Texte') }}</span>
                        </div>
                    </div>
                    {% if not readonly %}
                        <div class="flex items-center space-x-2 ml-4">
                            <button type="button" class="edit-riddle-btn text-blue-600 hover:text-blue-800 p-2" data-riddle-index="{{ loop.index0 }}">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                                </svg>
                            </button>
                            <button type="button" class="delete-riddle-btn text-red-600 hover:text-red-800 p-2" data-riddle-index="{{ loop.index0 }}">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                </svg>
                            </button>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
</div>
