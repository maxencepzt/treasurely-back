{% extends 'base.html.twig' %}

{% block title %}Modifier une équipe - Treasurely{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100">
        {{ include('designer/_partials/header.html.twig', {
            type: 'simple',
            title: 'Modifier une équipe',
            subtitle: 'Modifiez votre équipe de conception',
            backUrl: path('app_designer_team_details', {id: designerTeam.id}),
            backTitle: 'Retour aux détails',
        }) }}

        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            {{ include('designer/team/_form.html.twig', {
                mode: 'edit',
                designerTeam: designerTeam,
                members: members,
                submitButtonText: 'Enregistrer les modifications',
                cancelUrl: path('app_designer_team_details', {id: designerTeam.id}),
            }) }}
        </div>
    </div>

                    <!-- Recherche de membres -->
                    <div class="mb-6">
                        <label for="member_search" class="block text-sm font-semibold text-gray-700 mb-2">
                            Ajouter des concepteurs
                        </label>
                        <div class="relative">
                            <div class="relative">
                                <input
                                    type="text"
                                    id="member_search"
                                    placeholder="Rechercher par pseudo..."
                                    autocomplete="off"
                                    class="w-full px-4 py-3 pl-12 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent transition"
                                />
                                <svg class="w-5 h-5 text-gray-400 absolute left-4 top-1/2 transform -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                            </div>

                            <!-- Dropdown autocomplétion (rempli dynamiquement par JavaScript) -->
                            <div id="autocomplete_results" class="hidden absolute z-10 w-full mt-2 bg-white border border-gray-200 rounded-xl shadow-lg max-h-64 overflow-y-auto">
                            </div>
                        </div>
                        <p class="mt-2 text-sm text-gray-500">Recherchez et ajoutez des concepteurs à votre équipe</p>
                    </div>

                    <!-- Liste des membres -->
                    <div id="members_list">
                        <h3 class="text-sm font-semibold text-gray-700 mb-3">Membres ajoutés ({{ members|length }})</h3>
                        <div class="space-y-2">
                            {% for member in members %}
                                <div class="flex items-center justify-between p-4 bg-gradient-to-r from-blue-50 to-cyan-50 border-blue-200 rounded-xl border border-opacity-50 existing-member"
                                     data-user-id="{{ member.id }}"
                                     data-user-fullname="{{ member.firstname }} {{ member.lastname }}"
                                     data-user-nickname="{{ member.nickname }}">
                                    <div class="flex items-center space-x-3">
                                        <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center text-white font-bold text-sm">
                                            <img src="{{ path('_api_/users/{id}/picture_get', {id: member.id}) }}" alt="{{ member.nickname }}"/>
                                        </div>
                                        <div>
                                            <p class="font-semibold text-gray-800">{{ member.firstname }} {{ member.lastname }}</p>
                                            <p class="text-sm text-gray-500">@{{ member.nickname }}</p>
                                        </div>
                                    </div>
                                    <button type="button" class="remove-member text-red-600 hover:text-red-800 p-2 rounded-lg hover:bg-red-50 transition cursor-pointer" title="Retirer" data-user-id="{{ member.id }}">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                        </svg>
                                    </button>
                                </div>
                            {% else %}
                                <div class="p-6 text-center bg-gray-50 rounded-xl border-2 border-dashed border-gray-200">
                                    <svg class="w-12 h-12 text-gray-300 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                                    </svg>
                                    <p class="text-gray-500 text-sm">Aucun membre ajouté pour le moment</p>
                                    <p class="text-gray-400 text-xs mt-1">Utilisez la recherche ci-dessus pour ajouter des concepteurs</p>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>

                <!-- Boutons d'action -->
                <div class="flex items-center justify-between bg-white rounded-2xl shadow-lg p-6">
                    <a href="{{ path('app_designer_team') }}" class="text-gray-600 hover:text-gray-800 font-semibold px-6 py-3 rounded-xl hover:bg-gray-100 transition cursor-pointer">
                        Annuler
                    </a>
                    <div class="flex items-center space-x-3">
                        <button type="submit" class="bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-semibold px-8 py-3 rounded-xl shadow-lg transform transition hover:scale-105 cursor-pointer flex items-center space-x-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span>Enregistrer les modifications</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <script src="{{ asset('js/team-create.js') }}"></script>
{% endblock %}
