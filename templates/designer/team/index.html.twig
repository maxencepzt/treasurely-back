{% extends 'base.html.twig' %}
{% import 'designer/_partials/macros.html.twig' as ui %}
{% import 'designer/_partials/icons.html.twig' as icons %}

{% block title %}Mes équipes - Treasurely{% endblock %}

{# Carte d'équipe, propriétaire ou membre : même recette que les cartes de chasse. #}
{% macro team_card(team, role) %}
    {# Les imports du gabarit ne sont pas visibles dans une macro : on les refait ici. #}
    {% import 'designer/_partials/macros.html.twig' as ui %}
    {% import 'designer/_partials/icons.html.twig' as icons %}
    {% set styles = {
        owner: {chip: 'bg-green-50 text-green-700 border-green-100', hover: 'group-hover:border-green-300', label: 'Propriétaire'},
        member: {chip: 'bg-blue-50 text-blue-700 border-blue-100', hover: 'group-hover:border-blue-300', label: 'Membre'},
    } %}
    {% set style = styles[role] %}
    {% set nbHunts = team.hunts|filter(h => h.status != 'draft')|length %}
    <a href="{{ path('app_designer_team_details', {id: team.id}) }}" class="group block rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-500 focus-visible:ring-offset-2" aria-label="Voir l'équipe {{ team.name }}">
        <article class="{{ ui.card('p-5 h-full flex flex-col transition-all group-hover:shadow-md') }} {{ style.hover }}">
            <div class="flex items-start justify-between gap-3 mb-3">
                <div class="flex items-center gap-3 min-w-0">
                    <img src="{{ path('_api_/teams/{id}/picture_get', {id: team.id}) }}" alt="" loading="lazy" class="w-12 h-12 rounded-xl object-cover bg-slate-100 shrink-0" />
                    <div class="min-w-0">
                        <h3 class="text-lg font-bold text-slate-800 truncate">{{ team.name }}</h3>
                        <p class="text-xs text-slate-500 truncate">
                            {% if role == 'owner' %}Créée le {{ team.createdAt|date('d/m/Y') }}{% else %}Propriétaire : {{ team.owner.firstname }} {{ team.owner.lastname }}{% endif %}
                        </p>
                    </div>
                </div>
                <span class="shrink-0 border text-xs font-semibold px-2.5 py-1 rounded-full {{ style.chip }}">{{ style.label }}</span>
            </div>
            <p class="text-slate-600 text-sm mb-4 line-clamp-2">{{ team.description ?: 'Aucune description' }}</p>
            <ul class="mt-auto flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-600 pt-4 border-t border-slate-100">
                <li class="inline-flex items-center gap-1.5">
                    {{ ui.icon(icons.path('team'), 'w-4 h-4 text-slate-400') }}
                    <span class="tabular-nums">{{ team.members|length }} membre{{ team.members|length > 1 ? 's' }}</span>
                </li>
                <li class="inline-flex items-center gap-1.5">
                    {{ ui.icon(icons.path('chest'), 'w-4 h-4 text-slate-400') }}
                    <span class="tabular-nums">{{ nbHunts }} chasse{{ nbHunts > 1 ? 's' }}</span>
                </li>
            </ul>
        </article>
    </a>
{% endmacro %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100">
        {{ include('designer/_partials/header.html.twig', {
            type: 'with_action',
            title: 'Mes équipes',
            icon: 'players',
            iconTint: 'bg-blue-100 text-blue-600',
            backUrl: path('app_designer_dashboard'),
            actionUrl: path('app_designer_team_create'),
            actionText: 'Créer une équipe',
            actionColor: 'blue',
        }) }}

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-10">
            <section>
                <div class="flex items-center gap-3 mb-5">
                    {{ ui.badge(icons.path('sparkles'), 'bg-green-100 text-green-600') }}
                    <h2 class="text-xl font-bold text-slate-800">Mes équipes</h2>
                    <span class="bg-green-50 text-green-700 border border-green-100 text-sm font-semibold px-2.5 py-0.5 rounded-full tabular-nums">{{ ownedTeams|length }}</span>
                </div>
                {% if ownedTeams|length > 0 %}
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        {% for team in ownedTeams %}
                            {{ _self.team_card(team, 'owner') }}
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center py-12 px-6 bg-white rounded-2xl border-2 border-dashed border-slate-200">
                        <div class="mx-auto mb-4 w-12 h-12 rounded-xl bg-green-100 text-green-600 flex items-center justify-center">{{ ui.icon(icons.path('players'), 'w-6 h-6') }}</div>
                        <p class="text-slate-500 mb-5">Vous n'avez pas encore créé d'équipe.</p>
                        <a href="{{ path('app_designer_team_create') }}" class="{{ ui.btn('primary') }}">
                            {{ ui.icon(icons.path('plus')) }}
                            <span>Créer ma première équipe</span>
                        </a>
                    </div>
                {% endif %}
            </section>

            <section>
                <div class="flex items-center gap-3 mb-5">
                    {{ ui.badge(icons.path('players'), 'bg-blue-100 text-blue-600') }}
                    <h2 class="text-xl font-bold text-slate-800">Équipes dont je suis membre</h2>
                    <span class="bg-blue-50 text-blue-700 border border-blue-100 text-sm font-semibold px-2.5 py-0.5 rounded-full tabular-nums">{{ memberTeams|length }}</span>
                </div>
                {% if memberTeams|length > 0 %}
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                        {% for team in memberTeams %}
                            {{ _self.team_card(team, 'member') }}
                        {% endfor %}
                    </div>
                {% else %}
                    <div class="text-center py-12 px-6 bg-white rounded-2xl border-2 border-dashed border-slate-200">
                        <div class="mx-auto mb-4 w-12 h-12 rounded-xl bg-blue-100 text-blue-600 flex items-center justify-center">{{ ui.icon(icons.path('players'), 'w-6 h-6') }}</div>
                        <p class="text-slate-500">Vous n'êtes membre d'aucune équipe pour le moment.</p>
                    </div>
                {% endif %}
            </section>
        </div>
    </div>
{% endblock %}
