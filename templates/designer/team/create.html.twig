{% extends 'base.html.twig' %}

{% block title %}Créer une équipe - Treasurely{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100">
        <!-- Header -->
        <header class="bg-white shadow-md">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
                <div class="flex justify-between items-center">
                    <div class="flex items-center space-x-4">
                        <a href="{{ path('app_designer_team') }}" class="text-gray-600 hover:text-gray-800 transition cursor-pointer" title="Retour aux équipes">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                            </svg>
                        </a>
                        <div>
                            <h1 class="text-2xl font-bold text-gray-800">Créer une équipe</h1>
                            <p class="text-sm text-gray-500">Créez votre équipe de conception</p>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <form class="space-y-8">
                <!-- Section: Informations de base -->
                <div class="bg-white rounded-2xl shadow-lg p-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center space-x-2">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span>Informations de base</span>
                    </h2>

                    <div class="space-y-6">
                        <!-- Nom de l'équipe -->
                        <div>
                            <label for="team_name" class="block text-sm font-semibold text-gray-700 mb-2">
                                Nom de l'équipe <span class="text-red-500">*</span>
                            </label>
                            <input
                                type="text"
                                id="team_name"
                                name="team_name"
                                required
                                placeholder="Ex: Les Aventuriers, Team Rocket..."
                                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                            />
                            <p class="mt-1 text-sm text-gray-500">Choisissez un nom unique et mémorable pour votre équipe</p>
                        </div>

                        <!-- Description -->
                        <div>
                            <label for="team_description" class="block text-sm font-semibold text-gray-700 mb-2">
                                Description
                            </label>
                            <textarea
                                id="team_description"
                                name="team_description"
                                rows="4"
                                placeholder="Décrivez votre équipe, votre vision, vos objectifs..."
                                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition resize-none"
                            ></textarea>
                            <p class="mt-1 text-sm text-gray-500">Maximum 500 caractères</p>
                        </div>

                        <!-- Image de l'équipe (optionnel) -->
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Image de l'équipe
                            </label>
                            <div class="flex items-center space-x-4">
                                <div class="w-24 h-24 bg-gradient-to-br from-blue-100 to-blue-200 rounded-xl flex items-center justify-center text-3xl font-bold text-blue-600">
                                    ?
                                </div>
                                <div class="flex-1">
                                    <label for="team_image" class="cursor-pointer">
                                        <div class="border-2 border-dashed border-gray-300 rounded-xl px-6 py-4 hover:border-blue-500 transition">
                                            <div class="flex items-center space-x-3">
                                                <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                                </svg>
                                                <div>
                                                    <p class="text-sm font-semibold text-gray-700">Cliquez pour uploader une image</p>
                                                    <p class="text-xs text-gray-500">PNG, JPG jusqu'à 5MB</p>
                                                </div>
                                            </div>
                                        </div>
                                        <input type="file" id="team_image" name="team_image" accept="image/*" class="hidden" />
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section: Membres de l'équipe -->
                <div class="bg-white rounded-2xl shadow-lg p-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center space-x-2">
                        <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                        </svg>
                        <span>Membres de l'équipe</span>
                    </h2>

                    <!-- Recherche de membres -->
                    <div class="mb-6">
                        <label for="member_search" class="block text-sm font-semibold text-gray-700 mb-2">
                            Ajouter des concepteurs
                        </label>
                        <div class="relative">
                            <div class="relative">
                                <input
                                    type="text"
                                    id="member_search"
                                    placeholder="Rechercher par pseudo..."
                                    autocomplete="off"
                                    class="w-full px-4 py-3 pl-12 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent transition"
                                />
                                <svg class="w-5 h-5 text-gray-400 absolute left-4 top-1/2 transform -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                </svg>
                            </div>

                            <!-- Dropdown autocomplétion -->
                            <div id="autocomplete_results" class="hidden absolute z-10 w-full mt-2 bg-white border border-gray-200 rounded-xl shadow-lg max-h-64 overflow-y-auto">
                                <!-- Résultat 1 -->
                                <div class="p-3 hover:bg-blue-50 cursor-pointer transition flex items-center space-x-3 border-b border-gray-100">
                                    <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center text-white font-bold text-sm">
                                        AS
                                    </div>
                                    <div class="flex-1">
                                        <p class="font-semibold text-gray-800">Alice Smith</p>
                                        <p class="text-sm text-gray-500">@alicesmith</p>
                                    </div>
                                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                    </svg>
                                </div>

                                <!-- Résultat 2 -->
                                <div class="p-3 hover:bg-blue-50 cursor-pointer transition flex items-center space-x-3 border-b border-gray-100">
                                    <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-green-600 rounded-full flex items-center justify-center text-white font-bold text-sm">
                                        BJ
                                    </div>
                                    <div class="flex-1">
                                        <p class="font-semibold text-gray-800">Bob Johnson</p>
                                        <p class="text-sm text-gray-500">@bobjohnson</p>
                                    </div>
                                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                    </svg>
                                </div>

                                <!-- Résultat 3 -->
                                <div class="p-3 hover:bg-blue-50 cursor-pointer transition flex items-center space-x-3 border-b border-gray-100">
                                    <div class="w-10 h-10 bg-gradient-to-br from-purple-500 to-purple-600 rounded-full flex items-center justify-center text-white font-bold text-sm">
                                        CD
                                    </div>
                                    <div class="flex-1">
                                        <p class="font-semibold text-gray-800">Carol Davis</p>
                                        <p class="text-sm text-gray-500">@caroldavis</p>
                                    </div>
                                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                    </svg>
                                </div>

                                <!-- Résultat 4 -->
                                <div class="p-3 hover:bg-blue-50 cursor-pointer transition flex items-center space-x-3">
                                    <div class="w-10 h-10 bg-gradient-to-br from-orange-500 to-orange-600 rounded-full flex items-center justify-center text-white font-bold text-sm">
                                        DW
                                    </div>
                                    <div class="flex-1">
                                        <p class="font-semibold text-gray-800">David Wilson</p>
                                        <p class="text-sm text-gray-500">@davidwilson</p>
                                    </div>
                                    <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                    </svg>
                                </div>

                                <!-- Aucun résultat -->
                                <div class="hidden p-6 text-center">
                                    <svg class="w-12 h-12 text-gray-300 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                                    </svg>
                                    <p class="text-gray-500">Aucun utilisateur trouvé</p>
                                </div>
                            </div>
                        </div>
                        <p class="mt-2 text-sm text-gray-500">Recherchez et ajoutez des concepteurs à votre équipe</p>
                    </div>

                    <!-- Liste des membres ajoutés -->
                    <div id="members_list">
                        <h3 class="text-sm font-semibold text-gray-700 mb-3">Membres ajoutés (3)</h3>
                        <div class="space-y-2">
                            <!-- Membre 1 -->
                            <div class="flex items-center justify-between p-4 bg-gradient-to-r from-blue-50 to-cyan-50 rounded-xl border border-blue-200">
                                <div class="flex items-center space-x-3">
                                    <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center text-white font-bold text-sm">
                                        AS
                                    </div>
                                    <div>
                                        <p class="font-semibold text-gray-800">Alice Smith</p>
                                        <p class="text-sm text-gray-500">@alicesmith</p>
                                    </div>
                                </div>
                                <button type="button" class="text-red-600 hover:text-red-800 p-2 rounded-lg hover:bg-red-50 transition cursor-pointer" title="Retirer">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                    </svg>
                                </button>
                            </div>

                            <!-- Membre 2 -->
                            <div class="flex items-center justify-between p-4 bg-gradient-to-r from-green-50 to-emerald-50 rounded-xl border border-green-200">
                                <div class="flex items-center space-x-3">
                                    <div class="w-10 h-10 bg-gradient-to-br from-green-500 to-green-600 rounded-full flex items-center justify-center text-white font-bold text-sm">
                                        BJ
                                    </div>
                                    <div>
                                        <p class="font-semibold text-gray-800">Bob Johnson</p>
                                        <p class="text-sm text-gray-500">@bobjohnson</p>
                                    </div>
                                </div>
                                <button type="button" class="text-red-600 hover:text-red-800 p-2 rounded-lg hover:bg-red-50 transition cursor-pointer" title="Retirer">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                    </svg>
                                </button>
                            </div>

                            <!-- Membre 3 -->
                            <div class="flex items-center justify-between p-4 bg-gradient-to-r from-purple-50 to-pink-50 rounded-xl border border-purple-200">
                                <div class="flex items-center space-x-3">
                                    <div class="w-10 h-10 bg-gradient-to-br from-purple-500 to-purple-600 rounded-full flex items-center justify-center text-white font-bold text-sm">
                                        CD
                                    </div>
                                    <div>
                                        <p class="font-semibold text-gray-800">Carol Davis</p>
                                        <p class="text-sm text-gray-500">@caroldavis</p>
                                    </div>
                                </div>
                                <button type="button" class="text-red-600 hover:text-red-800 p-2 rounded-lg hover:bg-red-50 transition cursor-pointer" title="Retirer">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <!-- Message si aucun membre -->
                        <div class="hidden p-6 text-center bg-gray-50 rounded-xl border-2 border-dashed border-gray-200">
                            <svg class="w-12 h-12 text-gray-300 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                            </svg>
                            <p class="text-gray-500 text-sm">Aucun membre ajouté pour le moment</p>
                            <p class="text-gray-400 text-xs mt-1">Utilisez la recherche ci-dessus pour ajouter des concepteurs</p>
                        </div>
                    </div>
                </div>

                <!-- Boutons d'action -->
                <div class="flex items-center justify-between bg-white rounded-2xl shadow-lg p-6">
                    <a href="/designer/teams" class="text-gray-600 hover:text-gray-800 font-semibold px-6 py-3 rounded-xl hover:bg-gray-100 transition cursor-pointer">
                        Annuler
                    </a>
                    <div class="flex items-center space-x-3">
                        <button type="submit" class="bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-semibold px-8 py-3 rounded-xl shadow-lg transform transition hover:scale-105 cursor-pointer flex items-center space-x-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span>Créer l'équipe</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Simulation de l'autocomplétion (à remplacer par un vrai appel API)
        document.addEventListener('DOMContentLoaded', function() {
            const searchInput = document.getElementById('member_search');
            const autocompleteResults = document.getElementById('autocomplete_results');

            // Afficher les résultats au focus
            searchInput.addEventListener('focus', function() {
                if (searchInput.value.length > 0 || true) { // true pour toujours afficher en mode démo
                    autocompleteResults.classList.remove('hidden');
                }
            });

            // Masquer les résultats au clic en dehors
            document.addEventListener('click', function(event) {
                if (!searchInput.contains(event.target) && !autocompleteResults.contains(event.target)) {
                    autocompleteResults.classList.add('hidden');
                }
            });

            // Filtrage en temps réel (démo)
            searchInput.addEventListener('input', function() {
                if (searchInput.value.length > 0) {
                    autocompleteResults.classList.remove('hidden');
                } else {
                    autocompleteResults.classList.add('hidden');
                }
            });

            // Ajout de membre (démo)
            autocompleteResults.querySelectorAll('div[class*="hover:bg-blue-50"]').forEach(function(item) {
                item.addEventListener('click', function() {
                    console.log('Membre ajouté:', item.querySelector('.font-semibold').textContent);
                    autocompleteResults.classList.add('hidden');
                    searchInput.value = '';
                    // Ici, vous ajouteriez le membre à la liste
                });
            });

            // Retirer un membre (démo)
            document.querySelectorAll('#members_list button').forEach(function(button) {
                button.addEventListener('click', function() {
                    const memberCard = button.closest('div[class*="rounded-xl"]');
                    memberCard.style.opacity = '0';
                    memberCard.style.transform = 'scale(0.95)';
                    setTimeout(() => {
                        memberCard.remove();
                        // Mettre à jour le compteur
                        const countElement = document.querySelector('#members_list h3');
                        const currentCount = parseInt(countElement.textContent.match(/\d+/)[0]);
                        countElement.textContent = `Membres ajoutés (${currentCount - 1})`;
                    }, 200);
                });
            });
        });
    </script>
{% endblock %}
