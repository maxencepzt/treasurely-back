{% extends 'base.html.twig' %}
{% import 'designer/_partials/macros.html.twig' as ui %}
{% import 'designer/_partials/icons.html.twig' as icons %}

{% block title %}{{ designerTeam.name }} - Treasurely{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100">
        {% set titleHtml %}
            <div class="flex items-center gap-3">
                <img src="{{ path('_api_/teams/{id}/picture_get', {id: designerTeam.id}) }}" alt="" class="w-12 h-12 rounded-xl object-cover bg-slate-100" />
                <div>
                    <h1 class="text-2xl font-bold text-slate-800">{{ designerTeam.name }}</h1>
                    <p class="text-sm text-slate-500">Créée le {{ designerTeam.createdAt|date('d/m/Y') }}</p>
                </div>
            </div>
        {% endset %}
        {% set actionsHtml %}
            {% if canEdit %}
                <a href="{{ path('app_designer_team_edit', {id: designerTeam.id}) }}" class="{{ ui.btn('blue') }}">
                    {{ ui.icon(icons.path('edit')) }}
                    <span>Modifier</span>
                </a>
            {% endif %}
        {% endset %}

        {{ include('designer/_partials/header.html.twig', {
            type: 'simple',
            title: titleHtml,
            backUrl: path('app_designer_team'),
            backTitle: 'Retour aux équipes',
            actions: actionsHtml,
        }) }}

        {% set hunts = treasureHunts|filter(h => h.status != 'draft') %}
        {% set statusBadges = {
            opened: {label: 'Ouverte', class: 'bg-green-600'},
            closed: {label: 'Fermée', class: 'bg-slate-600'},
        } %}

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                {{ ui.stat('Concepteurs', designerTeam.members.count, 'dans l\'équipe', icons.path('team'), 'bg-blue-100 text-blue-600') }}
                {{ ui.stat('Chasses publiées', hunts|length, (treasureHunts|length - hunts|length) ~ ' en brouillon', icons.path('chest'), 'bg-green-100 text-green-600') }}
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <div class="lg:col-span-2 space-y-8">
                    <div class="{{ ui.card('p-6') }}">
                        <div class="mb-4">{{ ui.card_title('Description', icons.path('text'), 'bg-green-100 text-green-600') }}</div>
                        {% if designerTeam.description is empty %}
                            <p class="text-slate-500 text-sm bg-slate-50 border border-dashed border-slate-200 rounded-xl p-6 text-center">Aucune description.</p>
                        {% else %}
                            <p class="text-slate-600 leading-relaxed whitespace-pre-line">{{ designerTeam.description }}</p>
                        {% endif %}
                    </div>

                    <div class="{{ ui.card('p-6') }}">
                        <div class="flex items-center justify-between gap-4 mb-5">
                            {{ ui.card_title('Concepteurs (' ~ designerTeam.members.count ~ ')', icons.path('team'), 'bg-blue-100 text-blue-600') }}
                            {% if canEdit %}
                                <button type="button" id="addMemberBtn" data-team-id="{{ designerTeam.id }}" class="{{ ui.btn('blue', 'sm') }} shrink-0">
                                    {{ ui.icon(icons.path('plus'), 'w-4 h-4') }}
                                    <span>Ajouter</span>
                                </button>
                            {% endif %}
                        </div>
                        <ul class="space-y-2">
                            <li class="flex items-center justify-between gap-4 p-3 rounded-xl border border-blue-100 bg-blue-50/60">
                                <div class="flex items-center gap-3 min-w-0">
                                    <img src="{{ path('_api_/users/{id}/picture_get', {id: designerTeam.owner.id}) }}" alt="" class="w-11 h-11 rounded-xl object-cover bg-slate-100 shrink-0" />
                                    <div class="min-w-0">
                                        <p class="font-semibold text-slate-800 truncate">{{ designerTeam.owner.firstname }} {{ designerTeam.owner.lastname }}</p>
                                        <p class="text-sm text-slate-500 truncate">@{{ designerTeam.owner.nickname }}</p>
                                    </div>
                                </div>
                                <span class="shrink-0 bg-blue-600 text-white text-xs font-semibold px-2.5 py-1 rounded-full">Propriétaire</span>
                            </li>
                            {% for member in designerTeam.members|filter(m => m.id != designerTeam.owner.id) %}
                                <li class="flex items-center justify-between gap-4 p-3 rounded-xl border border-slate-100 hover:bg-slate-50 transition-colors">
                                    <div class="flex items-center gap-3 min-w-0">
                                        <img src="{{ path('_api_/users/{id}/picture_get', {id: member.id}) }}" alt="" loading="lazy" class="w-11 h-11 rounded-xl object-cover bg-slate-100 shrink-0" />
                                        <div class="min-w-0">
                                            <p class="font-semibold text-slate-800 truncate">{{ member.firstname }} {{ member.lastname }}</p>
                                            <p class="text-sm text-slate-500 truncate">@{{ member.nickname }}</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-3 shrink-0">
                                        <span class="hidden sm:inline text-sm text-slate-500">Inscrit le {{ member.creationDate|date('d/m/Y') }}</span>
                                        {% if canDelete %}
                                            <button type="button" data-nickname="{{ member.nickname }}" data-user-id="{{ member.id }}" data-team-id="{{ designerTeam.id }}"
                                                    class="removeMemberBtn w-10 h-10 rounded-xl flex items-center justify-center text-red-600 hover:bg-red-50 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500"
                                                    title="Retirer de l'équipe" aria-label="Retirer {{ member.nickname }} de l'équipe">
                                                {{ ui.icon(icons.path('close')) }}
                                            </button>
                                        {% endif %}
                                    </div>
                                </li>
                            {% endfor %}
                        </ul>
                    </div>

                    <div class="{{ ui.card('p-6') }}">
                        <div class="mb-5">{{ ui.card_title('Chasses de l\'équipe (' ~ hunts|length ~ ')', icons.path('chest'), 'bg-green-100 text-green-600') }}</div>
                        {% if hunts is empty %}
                            <p class="text-slate-500 text-sm bg-slate-50 border border-dashed border-slate-200 rounded-xl p-6 text-center">Aucune chasse publiée.</p>
                        {% else %}
                            <ul class="space-y-2">
                                {% for hunt in hunts %}
                                    {% set badge = statusBadges[hunt.status]|default({label: hunt.status, class: 'bg-slate-600'}) %}
                                    <li>
                                        <a href="{{ path('app_designer_hunt_details', {id: hunt.id}) }}" class="flex items-center justify-between gap-4 p-3 rounded-xl border border-slate-200 hover:border-green-300 hover:shadow-sm transition-all focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-500">
                                            <div class="flex items-center gap-3 min-w-0">
                                                <img src="{{ path('_api_/treasure_hunts/{id}/picture_get', {id: hunt.id}) }}" alt="" loading="lazy" class="w-14 h-10 rounded-lg object-cover bg-slate-100 shrink-0" />
                                                <div class="min-w-0">
                                                    <p class="font-semibold text-slate-800 truncate">{{ hunt.title }}</p>
                                                    <p class="text-sm text-slate-500 truncate">{{ hunt.owner.firstname }} {{ hunt.owner.lastname }} · créée le {{ hunt.createdAt|date('d/m/Y') }}</p>
                                                </div>
                                            </div>
                                            <span class="shrink-0 {{ badge.class }} text-white text-xs font-semibold px-2.5 py-1 rounded-full">{{ badge.label }}</span>
                                        </a>
                                    </li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                </div>

                <div class="space-y-6">
                    <div class="{{ ui.card('p-6') }}">
                        <div class="mb-3">{{ ui.card_title('Informations', icons.path('info'), 'bg-slate-100 text-slate-600') }}</div>
                        <dl class="divide-y divide-slate-100 text-sm">
                            <div class="flex items-start justify-between gap-4 py-3">
                                <dt class="text-slate-500">Créée le</dt>
                                <dd class="font-semibold text-slate-800 text-right">{{ designerTeam.createdAt|format_datetime(pattern: 'd MMMM yyyy', locale: 'fr') }}</dd>
                            </div>
                            <div class="flex items-start justify-between gap-4 py-3">
                                <dt class="text-slate-500">Propriétaire</dt>
                                <dd class="font-semibold text-slate-800 text-right">{{ designerTeam.owner.firstname }} {{ designerTeam.owner.lastname }}</dd>
                            </div>
                        </dl>
                    </div>

                    <div class="{{ ui.card('p-6') }}">
                        <div class="mb-3">{{ ui.card_title('Actions', icons.path('bolt'), 'bg-orange-100 text-orange-600') }}</div>
                        {% set action = 'w-full text-left px-4 py-3 font-semibold rounded-xl transition-colors cursor-pointer flex items-center gap-3 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2' %}
                        <div class="space-y-2">
                            <a href="{{ path('app_designer_hunt_create', {designerTeamId: designerTeam.id}) }}" class="{{ action }} bg-green-50 hover:bg-green-100 text-green-700 focus-visible:ring-green-500">
                                {{ ui.icon(icons.path('plus')) }}
                                <span>Créer une nouvelle chasse</span>
                            </a>
                            {% if isOwner or is_granted('ROLE_ADMIN') %}
                                <button type="button" id="transferOwnershipBtn" data-team-name="{{ designerTeam.name }}" data-team-id="{{ designerTeam.id }}" class="{{ action }} bg-blue-50 hover:bg-blue-100 text-blue-700 focus-visible:ring-blue-500">
                                    {{ ui.icon(icons.path('key')) }}
                                    <span>Transférer la propriété</span>
                                </button>
                            {% endif %}
                            {% if not isOwner and isMember %}
                                <button type="button" id="leaveTeamBtn" data-team-name="{{ designerTeam.name }}" data-team-id="{{ designerTeam.id }}" class="{{ action }} bg-amber-50 hover:bg-amber-100 text-amber-700 focus-visible:ring-amber-500">
                                    {{ ui.icon(icons.path('logout')) }}
                                    <span>Quitter l'équipe</span>
                                </button>
                            {% endif %}
                            {% if canDelete %}
                                <button type="button" id="deleteTeamBtn" data-team-name="{{ designerTeam.name }}" data-team-id="{{ designerTeam.id }}" class="{{ action }} bg-red-50 hover:bg-red-100 text-red-700 focus-visible:ring-red-500">
                                    {{ ui.icon(icons.path('trash')) }}
                                    <span>Supprimer l'équipe</span>
                                </button>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {{ include('_partials/modal.html.twig', {id: 'globalModal'}) }}
    {{ include('_partials/toast.html.twig', {id: 'globalToast'}) }}
    {{ importmap('team-details') }}
{% endblock %}
