{% extends 'base.html.twig' %}

{% block title %}Treasurely - Détails de l'équipe{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100">
        <!-- Header -->
        <header class="bg-white shadow-md">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
                <div class="flex justify-between items-center">
                    <div class="flex items-center space-x-4">
                        <a href="{{ path('app_designer_team') }}" class="text-gray-600 hover:text-gray-800 transition cursor-pointer" title="Retour aux équipes">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                            </svg>
                        </a>
                        <div class="flex items-center space-x-3">
                            <div class="w-12 h-12 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-xl flex items-center justify-center overflow-hidden">
                                <img src="{{ path('_api_/teams/{id}/picture_get', {id: designerTeam.id}) }}" alt="{{ designerTeam.name }}" class="w-full h-full object-cover"/>
                            </div>
                            <div>
                                <h1 class="text-2xl font-bold text-gray-800">{{ designerTeam.name }}</h1>
                                <p class="text-sm text-gray-500">Créée le {{ designerTeam.createdAt|date('d/m/Y') }}</p>
                            </div>
                        </div>
                    </div>
                    <!-- Bouton modifier visible uniquement pour le propriétaire -->
                    {% if canEdit %}
                    <div class="flex items-center space-x-3">
                        <a href="{{ path('app_designer_team_edit', {id: designerTeam.id}) }}" class="bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-semibold px-6 py-3 rounded-xl shadow-lg transform transition hover:scale-105 focus:outline-none focus:ring-4 focus:ring-blue-300 flex items-center space-x-2 cursor-pointer">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                            </svg>
                            <span>Modifier</span>
                        </a>
                    </div>
                    {% endif %}
                </div>
            </div>
        </header>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <!-- Statistiques rapides -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                <!-- Concepteurs -->
                <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-blue-500">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-500 text-sm font-semibold uppercase">Concepteurs</p>
                            <p class="text-3xl font-bold text-gray-800 mt-1">{{ designerTeam.members.count }}</p>
                        </div>
                        <div class="p-3 bg-blue-100 rounded-lg">
                            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                            </svg>
                        </div>
                    </div>
                </div>

                <!-- Chasses créées -->
                <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-green-500">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-500 text-sm font-semibold uppercase">Chasses créées</p>
                            <p class="text-3xl font-bold text-gray-800 mt-1">{{ treasureHunts|length }}</p>
                        </div>
                        <div class="p-3 bg-green-100 rounded-lg">
                            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path d="M21 12.4984L14 12.4984M3 12.4984L10 12.4984M7 4.5V19.4984M17 4.5V19.4984M6.2 19.5H17.8C18.9201 19.5 19.4802 19.5 19.908 19.282C20.2843 19.0903 20.5903 18.7843 20.782 18.408C21 17.9802 21 17.4201 21 16.3V10.9C21 8.65979 21 7.53968 20.564 6.68404C20.1805 5.93139 19.5686 5.31947 18.816 4.93597C17.9603 4.5 16.8402 4.5 14.6 4.5H9.4C7.15979 4.5 6.03968 4.5 5.18404 4.93597C4.43139 5.31947 3.81947 5.93139 3.43597 6.68404C3 7.53968 3 8.65979 3 10.9V16.3C3 17.4201 3 17.9802 3.21799 18.408C3.40973 18.7843 3.71569 19.0903 4.09202 19.282C4.51984 19.5 5.07989 19.5 6.2 19.5ZM10 10.4984H14V14.4984H10V10.4984Z" stroke-width="2" stroke-linejoin="round"></path>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Colonne principale (2/3) -->
                <div class="lg:col-span-2 space-y-8">
                    <!-- Description -->
                    <div class="bg-white rounded-2xl shadow-lg p-6">
                        <h2 class="text-xl font-bold text-gray-800 mb-4 flex items-center space-x-2">
                            <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <span>Description</span>
                        </h2>
                        {% if designerTeam.description is null %}
                        <div class="p-6 text-center bg-gray-50 rounded-xl border-2 border-dashed border-gray-200">
                            <svg class="w-12 h-12 text-gray-300 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                            <p class="text-gray-500 text-sm">Aucune description</p>
                        </div>
                        {% else %}
                        <p class="text-gray-600 leading-relaxed">
                            {{ designerTeam.description }}
                        </p>
                        {% endif %}
                    </div>

                    <!-- Concepteurs de l'équipe -->
                    <div class="bg-white rounded-2xl shadow-lg p-6">
                        <div class="flex items-center justify-between mb-6">
                            <h2 class="text-xl font-bold text-gray-800 flex items-center space-x-2">
                                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                                </svg>
                                <span>Concepteurs ({{ designerTeam.members.count }})</span>
                            </h2>
                            {% if canEdit %}
                            <!-- Bouton ajouter concepteur visible uniquement pour le propriétaire -->
                            <button class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded-lg shadow transform transition hover:scale-105 flex items-center space-x-2 cursor-pointer">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                </svg>
                                <span>Ajouter un concepteur</span>
                            </button>
                            {% endif %}
                        </div>

                        <div class="space-y-3">
                            <!-- Concepteur (Propriétaire) -->
                            <div class="flex items-center justify-between p-4 bg-gradient-to-r from-blue-50 to-cyan-50 rounded-xl border-2 border-blue-200">
                                <div class="flex items-center space-x-4">
                                    <div class="w-12 h-12 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-xl flex items-center justify-center overflow-hidden">
                                        <img src="{{ path('_api_/users/{id}/picture_get', {id: designerTeam.owner.id}) }}" alt="{{ designerTeam.owner.nickname }}" class="w-full h-full object-cover"/>
                                    </div>
                                    <div>
                                        <p class="font-bold text-gray-800">{{ designerTeam.owner.firstname }} {{ designerTeam.owner.lastname }}</p>
                                        <p class="text-sm text-gray-500">@{{ designerTeam.owner.nickname }}</p>
                                    </div>
                                </div>
                                <div class="flex items-center space-x-2">
                                    <span class="bg-blue-600 text-white text-xs font-semibold px-3 py-1 rounded-full">Propriétaire</span>
                                </div>
                            </div>

                            <!-- Concepteurs -->
                            {% for member in designerTeam.members %}
                            {% if member.id != designerTeam.owner.id %}
                            <div class="flex items-center justify-between p-4 bg-gray-50 rounded-xl hover:bg-gray-100 transition">
                                <div class="flex items-center space-x-4">
                                    <div class="w-12 h-12 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-xl flex items-center justify-center overflow-hidden">
                                        <img src="{{ path('_api_/users/{id}/picture_get', {id: member.id}) }}" alt="{{ member.nickname }}" class="w-full h-full object-cover"/>
                                    </div>
                                    <div>
                                        <p class="font-bold text-gray-800">{{ member.firstname }} {{ member.lastname }}</p>
                                        <p class="text-sm text-gray-500">@{{ member.nickname }}</p>
                                    </div>
                                </div>
                                <div class="flex items-center space-x-2">
                                    <span class="text-gray-500 text-sm">Compte créé le {{ member.creationDate|date('d/m/Y') }}</span>
                                    {% if canDelete %}
                                        <!-- Bouton supprimer visible uniquement pour le propriétaire -->
                                        <button class="text-red-600 hover:text-red-800 p-2 rounded-lg hover:bg-red-50 transition cursor-pointer" title="Retirer de l'équipe">
                                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                            </svg>
                                        </button>
                                    {% endif %}
                                </div>
                            </div>
                            {% endif %}
                            {% endfor %}
                        </div>
                    </div>

                    <!-- Chasses au trésor créées -->
                    <div class="bg-white rounded-2xl shadow-lg p-6">
                        <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center space-x-2">
                            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path d="M21 12.4984L14 12.4984M3 12.4984L10 12.4984M7 4.5V19.4984M17 4.5V19.4984M6.2 19.5H17.8C18.9201 19.5 19.4802 19.5 19.908 19.282C20.2843 19.0903 20.5903 18.7843 20.782 18.408C21 17.9802 21 17.4201 21 16.3V10.9C21 8.65979 21 7.53968 20.564 6.68404C20.1805 5.93139 19.5686 5.31947 18.816 4.93597C17.9603 4.5 16.8402 4.5 14.6 4.5H9.4C7.15979 4.5 6.03968 4.5 5.18404 4.93597C4.43139 5.31947 3.81947 5.93139 3.43597 6.68404C3 7.53968 3 8.65979 3 10.9V16.3C3 17.4201 3 17.9802 3.21799 18.408C3.40973 18.7843 3.71569 19.0903 4.09202 19.282C4.51984 19.5 5.07989 19.5 6.2 19.5ZM10 10.4984H14V14.4984H10V10.4984Z" stroke-width="2" stroke-linejoin="round"></path>
                            </svg>
                            <span>Chasses créées par l'équipe ({{ treasureHunts|length }})</span>
                        </h2>

                        <div class="space-y-3">
                            {% for hunt in treasureHunts %}
                                {% if hunt.status != 'draft' %}
                                    <div class="p-4 bg-gradient-to-r
                                    {{ hunt.status == 'closed' ? 'from-gray-50 to-slate-50 border-gray-200' : 'from-emerald-50 to-emerald-100 border-emerald-200' }}
                                    rounded-xl border-2 hover:shadow-md transition cursor-pointer"
                                    >
                                        <div class="flex items-center justify-between mb-2">
                                            <h3 class="font-bold text-gray-800">{{ hunt.title }}</h3>
                                            {% if hunt.status == 'closed' %}
                                                <span class="bg-gray-600 text-white text-xs font-semibold px-3 py-1 rounded-full flex items-center space-x-1">
                                                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                                        <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"></path>
                                                    </svg>
                                                    <span>Fermée</span>
                                                </span>
                                            {% elseif hunt.status == 'opened' %}
                                                <span class="bg-green-600 text-white text-xs font-semibold px-3 py-1 rounded-full flex items-center space-x-1">
                                                    <svg class="w-3 h-3 animate-pulse" fill="currentColor" viewBox="0 0 20 20">
                                                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
                                                    </svg>
                                                    <span>Ouverte</span>
                                                </span>
                                            {% endif %}
                                        </div>
                                        <div class="flex items-center justify-between text-sm text-gray-600">
                                            <div class="flex items-center space-x-2">
                                                <div class="w-6 h-6 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-full flex items-center justify-center overflow-hidden">
                                                    <img src="{{ path('_api_/users/{id}/picture_get', {id: hunt.owner.id}) }}" alt="{{ hunt.owner.nickname }}" class="w-full h-full object-cover"/>
                                                </div>
                                                <span>{{ hunt.owner.firstname }} {{ hunt.owner.lastname }}</span>
                                            </div>
                                            <span>Créée le {{ hunt.createdAt|date('d/m/Y') }}</span>
                                        </div>
                                    </div>
                                {% endif %}
                            {% else %}
                                <div class="p-6 text-center bg-gray-50 rounded-xl border-2 border-dashed border-gray-200">
                                    <svg class="w-12 h-12 text-gray-300 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path d="M21 12.4984L14 12.4984M3 12.4984L10 12.4984M7 4.5V19.4984M17 4.5V19.4984M6.2 19.5H17.8C18.9201 19.5 19.4802 19.5 19.908 19.282C20.2843 19.0903 20.5903 18.7843 20.782 18.408C21 17.9802 21 17.4201 21 16.3V10.9C21 8.65979 21 7.53968 20.564 6.68404C20.1805 5.93139 19.5686 5.31947 18.816 4.93597C17.9603 4.5 16.8402 4.5 14.6 4.5H9.4C7.15979 4.5 6.03968 4.5 5.18404 4.93597C4.43139 5.31947 3.81947 5.93139 3.43597 6.68404C3 7.53968 3 8.65979 3 10.9V16.3C3 17.4201 3 17.9802 3.21799 18.408C3.40973 18.7843 3.71569 19.0903 4.09202 19.282C4.51984 19.5 5.07989 19.5 6.2 19.5ZM10 10.4984H14V14.4984H10V10.4984Z" stroke-width="2" stroke-linejoin="round"></path>
                                    </svg>
                                    <p class="text-gray-500 text-sm">Aucune chasse</p>
                                </div>
                            {% endfor %}

                            {% if treasureHunts|length != 0 %}
                                <!-- Voir plus -->
                                <button class="w-full py-3 text-center text-blue-600 hover:text-blue-800 font-semibold hover:bg-blue-50 rounded-xl transition cursor-pointer">
                                    Voir toutes les chasses →
                                </button>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Colonne secondaire (1/3) -->
                <div class="space-y-6">
                    <!-- Informations de l'équipe -->
                    <div class="bg-white rounded-2xl shadow-lg p-6">
                        <h2 class="text-xl font-bold text-gray-800 mb-4 flex items-center space-x-2">
                            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <span>Informations</span>
                        </h2>
                        <div class="space-y-3">
                            <div class="flex items-center space-x-3 text-sm">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                </svg>
                                <div>
                                    <p class="text-gray-500">Créée le</p>
                                    <p class="font-semibold text-gray-800">
                                        {{ designerTeam.createdAt|format_datetime(pattern: 'd MMMM yyyy', locale: 'fr') }}
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center space-x-3 text-sm">
                                <svg class="w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                                </svg>
                                <div>
                                    <p class="text-gray-500">Propriétaire</p>
                                    <p class="font-semibold text-gray-800">{{ designerTeam.owner.firstname }} {{ designerTeam.owner.lastname }}</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Actions rapides -->
                    <div class="bg-white rounded-2xl shadow-lg p-6">
                        <h2 class="text-xl font-bold text-gray-800 mb-4 flex items-center space-x-2">
                            <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                            </svg>
                            <span>Actions</span>
                        </h2>
                        <div class="space-y-2">
                            <a href="{{ path('app_designer_hunt_create', {designerTeamId: designerTeam.id}) }}" class="w-full text-left px-4 py-3 bg-green-50 hover:bg-green-100 text-green-700 font-semibold rounded-xl transition flex items-center space-x-3 cursor-pointer">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                                </svg>
                                <span>Créer une nouvelle chasse</span>
                            </a>
                            {% if not isOwner %}
                                <button id="leaveTeamBtn" data-team-name="{{ designerTeam.name }}" data-team-id="{{ designerTeam.id }}" class="w-full text-left px-4 py-3 bg-yellow-50 hover:bg-yellow-100 text-yellow-700 font-semibold rounded-xl transition flex items-center space-x-3 cursor-pointer">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                    </svg>
                                    <span>Quitter l'équipe</span>
                                </button>
                            {% endif %}
                            {% if canDelete %}
                                <button id="deleteTeamBtn" data-team-name="{{ designerTeam.name }}" data-team-id="{{ designerTeam.id }}" class="w-full text-left px-4 py-3 bg-red-50 hover:bg-red-100 text-red-700 font-semibold rounded-xl transition flex items-center space-x-3 cursor-pointer">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                                    </svg>
                                    <span>Supprimer l'équipe</span>
                                </button>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de confirmation pour supprimer l'équipe -->
    <div id="deleteModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full transform transition-all">
            <div class="p-6">
                <!-- Icône d'avertissement -->
                <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
                    </svg>
                </div>
                <!-- Titre -->
                <h3 class="text-xl font-bold text-gray-900 text-center mb-2">Supprimer l'équipe ?</h3>
                <!-- Message -->
                <p class="text-gray-600 text-center mb-2">
                    Êtes-vous sûr de vouloir supprimer l'équipe <span class="font-semibold text-gray-900" id="deleteTeamName"></span> ?
                </p>
                <p class="text-red-600 text-sm text-center mb-6">
                    ⚠️ Cette action est irréversible et supprimera également toutes les chasses au trésor associées.
                </p>
                <!-- Boutons -->
                <div class="flex space-x-3">
                    <button id="cancelDeleteBtn" class="flex-1 px-4 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-xl transition">
                        Annuler
                    </button>
                    <button id="confirmDeleteBtn" class="flex-1 px-4 py-3 bg-red-600 hover:bg-red-700 text-white font-semibold rounded-xl transition flex items-center justify-center space-x-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                        </svg>
                        <span>Supprimer</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal de confirmation pour quitter l'équipe -->
    <div id="leaveModal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full transform transition-all">
            <div class="p-6">
                <!-- Icône d'avertissement -->
                <div class="w-16 h-16 bg-yellow-100 rounded-full flex items-center justify-center mx-auto mb-4">
                    <svg class="w-8 h-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                    </svg>
                </div>
                <!-- Titre -->
                <h3 class="text-xl font-bold text-gray-900 text-center mb-2">Quitter l'équipe ?</h3>
                <!-- Message -->
                <p class="text-gray-600 text-center mb-6">
                    Êtes-vous sûr de vouloir quitter l'équipe <span class="font-semibold text-gray-900" id="leaveTeamName"></span> ?
                    <br><br>
                    Vous n'aurez plus accès aux chasses au trésor de cette équipe.
                </p>
                <!-- Boutons -->
                <div class="flex space-x-3">
                    <button id="cancelLeaveBtn" class="flex-1 px-4 py-3 bg-gray-100 hover:bg-gray-200 text-gray-700 font-semibold rounded-xl transition">
                        Annuler
                    </button>
                    <button id="confirmLeaveBtn" class="flex-1 px-4 py-3 bg-yellow-600 hover:bg-yellow-700 text-white font-semibold rounded-xl transition flex items-center justify-center space-x-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                        </svg>
                        <span>Quitter</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast de notification -->
    <div id="toast" class="hidden fixed top-4 right-4 z-50 transform transition-all duration-300">
        <div class="bg-white rounded-xl shadow-2xl p-4 flex items-center space-x-3 min-w-[300px]">
            <div id="toastIcon" class="flex-shrink-0"></div>
            <div class="flex-1">
                <p id="toastMessage" class="font-semibold text-gray-900"></p>
            </div>
        </div>
    </div>

    <script>
        // Gestion des modales
        const deleteModal = document.getElementById('deleteModal');
        const leaveModal = document.getElementById('leaveModal');
        const toast = document.getElementById('toast');

        // Fonction pour afficher un toast
        function showToast(message, isSuccess = true) {
            const toastIcon = document.getElementById('toastIcon');
            const toastMessage = document.getElementById('toastMessage');

            toastMessage.textContent = message;

            if (isSuccess) {
                toastIcon.innerHTML = `
                    <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                        </svg>
                    </div>
                `;
            } else {
                toastIcon.innerHTML = `
                    <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center">
                        <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                        </svg>
                    </div>
                `;
            }

            toast.classList.remove('hidden');
            setTimeout(() => {
                toast.classList.add('hidden');
            }, 3000);
        }

        // Supprimer l'équipe
        const deleteTeamBtn = document.getElementById('deleteTeamBtn');
        const cancelDeleteBtn = document.getElementById('cancelDeleteBtn');
        const confirmDeleteBtn = document.getElementById('confirmDeleteBtn');

        if (deleteTeamBtn) {
            let teamId, teamName;

            deleteTeamBtn.addEventListener('click', function(e) {
                e.preventDefault();
                teamName = this.dataset.teamName;
                teamId = this.dataset.teamId;

                document.getElementById('deleteTeamName').textContent = teamName;
                deleteModal.classList.remove('hidden');
            });

            cancelDeleteBtn.addEventListener('click', function() {
                deleteModal.classList.add('hidden');
            });

            confirmDeleteBtn.addEventListener('click', function() {
                // Désactiver le bouton pendant la requête
                this.disabled = true;
                this.innerHTML = `
                    <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span>Suppression...</span>
                `;

                fetch(`/designer/team/${teamId}/delete`, {
                    method: 'DELETE',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(response => response.json())
                .then(data => {
                    deleteModal.classList.add('hidden');
                    if (data.success) {
                        showToast(data.message, true);
                        setTimeout(() => {
                            window.location.href = '/designer/team';
                        }, 1500);
                    } else {
                        showToast(data.error || 'Une erreur est survenue', false);
                        this.disabled = false;
                        this.innerHTML = `
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                            </svg>
                            <span>Supprimer</span>
                        `;
                    }
                })
                .catch(error => {
                    console.error('Erreur:', error);
                    deleteModal.classList.add('hidden');
                    showToast('Une erreur est survenue lors de la suppression de l\'équipe', false);
                    this.disabled = false;
                    this.innerHTML = `
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path>
                        </svg>
                        <span>Supprimer</span>
                    `;
                });
            });

            // Fermer la modale en cliquant en dehors
            deleteModal.addEventListener('click', function(e) {
                if (e.target === deleteModal) {
                    deleteModal.classList.add('hidden');
                }
            });
        }

        // Quitter l'équipe
        const leaveTeamBtn = document.getElementById('leaveTeamBtn');
        const cancelLeaveBtn = document.getElementById('cancelLeaveBtn');
        const confirmLeaveBtn = document.getElementById('confirmLeaveBtn');

        if (leaveTeamBtn) {
            let teamId, teamName;

            leaveTeamBtn.addEventListener('click', function(e) {
                e.preventDefault();
                teamName = this.dataset.teamName;
                teamId = this.dataset.teamId;

                document.getElementById('leaveTeamName').textContent = teamName;
                leaveModal.classList.remove('hidden');
            });

            cancelLeaveBtn.addEventListener('click', function() {
                leaveModal.classList.add('hidden');
            });

            confirmLeaveBtn.addEventListener('click', function() {
                // Désactiver le bouton pendant la requête
                this.disabled = true;
                this.innerHTML = `
                    <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                    <span>En cours...</span>
                `;

                fetch(`/designer/team/${teamId}/leave`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    }
                })
                .then(response => response.json())
                .then(data => {
                    leaveModal.classList.add('hidden');
                    if (data.success) {
                        showToast(data.message, true);
                        setTimeout(() => {
                            window.location.href = '/designer/team';
                        }, 1500);
                    } else {
                        showToast(data.error || 'Une erreur est survenue', false);
                        this.disabled = false;
                        this.innerHTML = `
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                            </svg>
                            <span>Quitter</span>
                        `;
                    }
                })
                .catch(error => {
                    console.error('Erreur:', error);
                    leaveModal.classList.add('hidden');
                    showToast('Une erreur est survenue', false);
                    this.disabled = false;
                    this.innerHTML = `
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path>
                        </svg>
                        <span>Quitter</span>
                    `;
                });
            });

            // Fermer la modale en cliquant en dehors
            leaveModal.addEventListener('click', function(e) {
                if (e.target === leaveModal) {
                    leaveModal.classList.add('hidden');
                }
            });
        }
    </script>
{% endblock %}
