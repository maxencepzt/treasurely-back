{# Partial réutilisable pour le formulaire d'équipe (création et édition) #}
{# Variables attendues :
   - mode: 'create' ou 'edit'
   - designerTeam: objet équipe (null pour create)
   - members: liste des membres (vide pour create)
   - submitButtonText: texte du bouton submit
   - cancelUrl: URL de retour
#}

<form class="space-y-8" data-team-form data-mode="{{ mode }}">
    <!-- Section: Informations de base -->
    <div class="bg-white rounded-2xl shadow-lg p-6">
        <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center space-x-2">
            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
            <span>Informations de base</span>
        </h2>

        <div class="space-y-6">
            <!-- Nom de l'équipe -->
            <div>
                <label for="team_name" class="block text-sm font-semibold text-gray-700 mb-2">
                    Nom de l'équipe <span class="text-red-500">*</span>
                </label>
                <input
                    type="text"
                    id="team_name"
                    name="team_name"
                    required
                    placeholder="Ex: Les Aventuriers, Team Rocket..."
                    class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition"
                    value="{{ designerTeam.name|default('') }}"
                />
                <p class="mt-1 text-sm text-gray-500">Choisissez un nom unique et mémorable pour votre équipe</p>
            </div>

            <!-- Description -->
            <div>
                <label for="team_description" class="block text-sm font-semibold text-gray-700 mb-2">
                    Description
                </label>
                <textarea
                    id="team_description"
                    name="team_description"
                    rows="4"
                    placeholder="Décrivez votre équipe, votre vision, vos objectifs..."
                    class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent transition resize-none"
                >{{ designerTeam.description|default('') }}</textarea>
                <p class="mt-1 text-sm text-gray-500">Maximum 500 caractères</p>
            </div>

            <!-- Image de l'équipe (optionnel) -->
            <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">
                    Image de l'équipe
                </label>
                <div class="flex items-center space-x-4">
                    <div class="w-24 h-24 bg-gradient-to-br from-blue-100 to-blue-200 rounded-xl flex items-center justify-center text-3xl font-bold text-blue-600 overflow-hidden">
                        {% if mode == 'edit' and designerTeam %}
                            <img src="{{ path('_api_/teams/{id}/picture_get', {id: designerTeam.id}) }}" alt="{{ designerTeam.name }}" class="w-full h-full object-cover" />
                        {% else %}
                            ?
                        {% endif %}
                    </div>
                    <div class="flex-1 relative">
                        <label for="team_image" class="cursor-pointer block">
                            <div class="border-2 border-dashed border-gray-300 rounded-xl px-6 py-4 transition-all duration-300 ease-in-out hover:border-blue-400 hover:bg-blue-50">
                                <div class="flex items-center space-x-3">
                                    <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                    </svg>
                                    <div>
                                        <p class="text-sm font-semibold text-gray-700">Cliquez ou glissez-déposez une image</p>
                                        <p class="text-xs text-gray-500">PNG, JPG, GIF jusqu'à 5MB</p>
                                    </div>
                                </div>
                            </div>
                            <input type="file" id="team_image" name="team_image" accept="image/*" class="hidden" />
                        </label>
                        <p class="mt-2 text-xs text-gray-400 flex items-center">
                            <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                            </svg>
                            Glissez-déposez votre image directement dans la zone ci-dessus
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Section : Membres de l'équipe -->
    <div class="bg-white rounded-2xl shadow-lg p-6">
        <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center space-x-2">
            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
            </svg>
            <span>Membres de l'équipe</span>
        </h2>

        <!-- Recherche de membres -->
        <div class="mb-6">
            <label for="member_search" class="block text-sm font-semibold text-gray-700 mb-2">
                Ajouter des concepteurs
            </label>
            <div class="relative">
                <div class="relative">
                    <input
                        type="text"
                        id="member_search"
                        placeholder="Rechercher par pseudo..."
                        autocomplete="off"
                        class="w-full px-4 py-3 pl-12 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent transition"
                    />
                    <svg class="w-5 h-5 text-gray-400 absolute left-4 top-1/2 transform -translate-y-1/2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </div>

                <!-- Dropdown autocomplétion (rempli dynamiquement par JavaScript) -->
                <div id="autocomplete_results" class="hidden absolute z-10 w-full mt-2 bg-white border border-gray-200 rounded-xl shadow-lg max-h-64 overflow-y-auto">
                </div>
            </div>
            <p class="mt-2 text-sm text-gray-500">Recherchez et ajoutez des concepteurs à votre équipe</p>
        </div>

        <!-- Liste des membres -->
        <div id="members_list">
            <h3 class="text-sm font-semibold text-gray-700 mb-3">Membres ajoutés ({{ members|length|default(0) }})</h3>
            <div class="space-y-2">
                {% if mode == 'edit' and members is defined and members|length > 0 %}
                    {% for member in members %}
                        <div class="flex items-center justify-between p-4 bg-gradient-to-r from-blue-50 to-cyan-50 border-blue-200 rounded-xl border border-opacity-50 existing-member"
                             data-user-id="{{ member.id }}"
                             data-user-fullname="{{ member.firstname }} {{ member.lastname }}"
                             data-user-nickname="{{ member.nickname }}">
                            <div class="flex items-center space-x-3">
                                <div class="w-10 h-10 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center text-white font-bold text-sm overflow-hidden">
                                    <img src="{{ path('_api_/users/{id}/picture_get', {id: member.id}) }}" alt="{{ member.nickname }}"/>
                                </div>
                                <div>
                                    <p class="font-semibold text-gray-800">{{ member.firstname }} {{ member.lastname }}</p>
                                    <p class="text-sm text-gray-500">@{{ member.nickname }}</p>
                                </div>
                            </div>
                            <button type="button" class="remove-member text-red-600 hover:text-red-800 p-2 rounded-lg hover:bg-red-50 transition cursor-pointer" title="Retirer" data-user-id="{{ member.id }}">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                                </svg>
                            </button>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="p-6 text-center bg-gray-50 rounded-xl border-2 border-dashed border-gray-200">
                        <svg class="w-12 h-12 text-gray-300 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
                        </svg>
                        <p class="text-gray-500 text-sm">Aucun membre ajouté pour le moment</p>
                        <p class="text-gray-400 text-xs mt-1">Utilisez la recherche ci-dessus pour ajouter des concepteurs</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Boutons d'action -->
    <div class="flex items-center justify-between bg-white rounded-2xl shadow-lg p-6">
        <a href="{{ cancelUrl }}" class="text-gray-600 hover:text-gray-800 font-semibold px-6 py-3 rounded-xl hover:bg-gray-100 transition cursor-pointer">
            Annuler
        </a>
        <div class="flex items-center space-x-3">
            <button type="submit" class="bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-semibold px-8 py-3 rounded-xl shadow-lg transform transition hover:scale-105 cursor-pointer flex items-center space-x-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                <span>{{ submitButtonText }}</span>
            </button>
        </div>
    </div>
</form>
