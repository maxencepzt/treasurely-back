{# Formulaire d'équipe, création et édition. Variables :
   - mode : 'create' ou 'edit'
   - designerTeam : l'équipe en édition, null en création
   - members : membres actuels (vide en création)
   - submitButtonText, cancelUrl #}
{% import 'designer/_partials/macros.html.twig' as ui %}
{% import 'designer/_partials/icons.html.twig' as icons %}

<form class="space-y-6" data-team-form data-mode="{{ mode }}">
    <div class="{{ ui.card('p-6') }}">
        <div class="mb-5">{{ ui.card_title('Informations de base', icons.path('info'), 'bg-blue-100 text-blue-600') }}</div>
        <div class="space-y-5">
            <div>
                {{ ui.label('team_name', 'Nom de l\'équipe', true) }}
                <input type="text" id="team_name" name="team_name" required maxlength="100" placeholder="Ex : Les Aventuriers" class="{{ ui.input() }}" value="{{ designerTeam.name|default('') }}" />
                <p class="mt-1 text-sm text-slate-500">Un nom court et reconnaissable.</p>
            </div>
            <div>
                {{ ui.label('team_description', 'Description') }}
                <textarea id="team_description" name="team_description" rows="4" maxlength="500" placeholder="Décrivez votre équipe, sa spécialité, ses envies…" class="{{ ui.textarea() }}">{{ designerTeam.description|default('') }}</textarea>
                <p class="mt-1 text-sm text-slate-500">500 caractères maximum.</p>
            </div>
            <div>
                <span class="block text-sm font-semibold text-slate-700 mb-2">Image de l'équipe</span>
                <div class="flex items-center gap-4">
                    <div class="w-24 h-24 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-400 overflow-hidden shrink-0">
                        {% if mode == 'edit' and designerTeam %}
                            <img src="{{ path('_api_/teams/{id}/picture_get', {id: designerTeam.id}) }}" alt="" class="w-full h-full object-cover" />
                        {% else %}
                            {{ ui.icon(icons.path('image'), 'w-8 h-8') }}
                        {% endif %}
                    </div>
                    <label for="team_image" class="flex-1 cursor-pointer">
                        <div class="border-2 border-dashed border-slate-300 rounded-xl px-5 py-4 transition-colors hover:border-blue-400 hover:bg-blue-50 flex items-center gap-3">
                            {{ ui.icon(icons.path('image'), 'w-6 h-6 text-slate-400 shrink-0') }}
                            <div>
                                <p class="text-sm font-semibold text-slate-700">Cliquez ou glissez-déposez une image</p>
                                <p class="text-xs text-slate-500">PNG, JPG, GIF ou WebP, 5 Mo maximum</p>
                            </div>
                        </div>
                        <input type="file" id="team_image" name="team_image" accept="image/*" class="hidden" />
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div class="{{ ui.card('p-6') }}">
        <div class="mb-5">{{ ui.card_title('Membres de l\'équipe', icons.path('team'), 'bg-purple-100 text-purple-600') }}</div>
        <div class="mb-6">
            {{ ui.label('member_search', 'Ajouter des concepteurs') }}
            <div class="relative">
                <div class="relative">
                    <input type="text" id="member_search" placeholder="Rechercher par pseudo…" autocomplete="off" class="{{ ui.input('pl-11') }}" />
                    {{ ui.icon(icons.path('search'), 'w-5 h-5 text-slate-400 absolute left-4 top-1/2 -translate-y-1/2 pointer-events-none') }}
                </div>
                <div id="autocomplete_results" class="hidden absolute z-10 w-full mt-2 bg-white border border-slate-200 rounded-xl shadow-lg max-h-64 overflow-y-auto"></div>
            </div>
            <p class="mt-1 text-sm text-slate-500">Tapez au moins deux caractères, puis choisissez dans la liste.</p>
        </div>

        <div id="members_list">
            <h3 class="text-sm font-semibold text-slate-700 mb-3">Membres ajoutés ({{ members|length|default(0) }})</h3>
            <div class="space-y-2">
                {% if mode == 'edit' and members is defined and members|length > 0 %}
                    {% for member in members %}
                        <div class="flex items-center justify-between gap-4 p-3 rounded-xl border border-slate-200 bg-white existing-member"
                             data-user-id="{{ member.id }}"
                             data-user-fullname="{{ member.firstname }} {{ member.lastname }}"
                             data-user-nickname="{{ member.nickname }}">
                            <div class="flex items-center gap-3 min-w-0">
                                <img src="{{ path('_api_/users/{id}/picture_get', {id: member.id}) }}" alt="" class="w-10 h-10 rounded-xl object-cover bg-slate-100 shrink-0" />
                                <div class="min-w-0">
                                    <p class="font-semibold text-slate-800 truncate">{{ member.firstname }} {{ member.lastname }}</p>
                                    <p class="text-sm text-slate-500 truncate">@{{ member.nickname }}</p>
                                </div>
                            </div>
                            <button type="button" class="remove-member w-10 h-10 rounded-xl flex items-center justify-center text-red-600 hover:bg-red-50 transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-500" title="Retirer" aria-label="Retirer {{ member.nickname }}" data-user-id="{{ member.id }}">
                                {{ ui.icon(icons.path('close')) }}
                            </button>
                        </div>
                    {% endfor %}
                {% else %}
                    <div class="p-6 text-center bg-slate-50 rounded-xl border-2 border-dashed border-slate-200">
                        <div class="mx-auto mb-2 w-10 h-10 rounded-xl bg-white border border-slate-200 text-slate-400 flex items-center justify-center">{{ ui.icon(icons.path('players')) }}</div>
                        <p class="text-slate-500 text-sm">Aucun membre ajouté pour le moment</p>
                        <p class="text-slate-400 text-xs mt-1">Utilisez la recherche ci-dessus pour ajouter des concepteurs</p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    <div class="{{ ui.card('p-4 flex items-center justify-between gap-4') }}">
        <a href="{{ cancelUrl }}" class="{{ ui.btn('ghost') }}">Annuler</a>
        <button type="submit" class="{{ ui.btn('blue') }}">
            {{ ui.icon(icons.path('check_plain')) }}
            <span>{{ submitButtonText }}</span>
        </button>
    </div>
</form>
