{# Partial générique universel pour tous les headers
   Variables attendues :
   - type: 'dashboard' | 'simple' | 'with_action' (défaut: 'simple')

   Pour type='dashboard':
   - user: objet utilisateur (app.user)
   - homeUrl: URL de retour à l'accueil

   Pour type='simple':
   - title: titre principal
   - subtitle: sous-titre (optionnel)
   - backUrl: URL de retour
   - backTitle: titre du lien de retour (optionnel, défaut "Retour")
   - actions: HTML personnalisé pour actions (optionnel)

   Pour type='with_action':
   - title: titre principal
   - icon: code SVG de l'icône (raw) (optionnel)
   - backUrl: URL de retour
   - backTitle: titre du lien de retour (optionnel)
   - actionUrl: URL du bouton d'action (optionnel)
   - actionText: texte du bouton d'action (optionnel)
   - actionColor: couleur du bouton (défaut: 'blue')
#}

{% set headerType = type|default('simple') %}

<header class="bg-white shadow-md">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex justify-between items-center">
            {# Partie gauche du header #}
            <div class="flex items-center {% if headerType == 'dashboard' %}space-x-3{% else %}space-x-4{% endif %}">
                {% if headerType == 'dashboard' %}
                    {# Logo Treasurely pour dashboard #}
                    <svg class="w-10 h-10 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                    </svg>
                    <h1 class="text-2xl font-bold text-gray-800">Treasurely</h1>
                {% else %}
                    {# Bouton retour pour les autres types #}
                    <a href="{{ backUrl }}" class="text-gray-600 hover:text-gray-800 transition cursor-pointer" title="{{ backTitle|default('Retour') }}">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                        </svg>
                    </a>

                    {% if headerType == 'with_action' %}
                        {# Header avec icône et titre #}
                        <div class="flex items-center space-x-3">
                            {% if icon is defined %}
                                {{ icon|raw }}
                            {% endif %}
                            <h1 class="text-2xl font-bold text-gray-800">{{ title }}</h1>
                        </div>
                    {% else %}
                        {# Header simple avec titre et sous-titre #}
                        <div>
                            <h1 class="text-2xl font-bold text-gray-800">{{ title }}</h1>
                            {% if subtitle is defined and subtitle %}
                                <p class="text-sm text-gray-500">{{ subtitle }}</p>
                            {% endif %}
                        </div>
                    {% endif %}
                {% endif %}
            </div>

            {# Partie droite du header #}
            {% if headerType == 'dashboard' %}
                {# Actions du dashboard #}
                <div class="flex items-center space-x-4">
                    <span class="text-gray-600">Bonjour, <span class="font-semibold">{{ user.nickname }}</span></span>
                    <a href="{{ homeUrl }}" class="text-gray-600 hover:text-gray-800 transition cursor-pointer">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path>
                        </svg>
                    </a>
                </div>
            {% elseif headerType == 'with_action' and actionUrl is defined and actionText is defined %}
                {# Bouton d'action pour les listes #}
                {% set btnColor = actionColor|default('blue') %}
                <a href="{{ actionUrl }}" class="bg-gradient-to-r from-{{ btnColor }}-600 to-{{ btnColor }}-700 hover:from-{{ btnColor }}-700 hover:to-{{ btnColor }}-800 text-white font-semibold px-6 py-3 rounded-xl shadow-lg transform transition hover:scale-105 focus:outline-none focus:ring-4 focus:ring-{{ btnColor }}-300 flex items-center space-x-2 cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                    </svg>
                    <span>{{ actionText }}</span>
                </a>
            {% elseif actions is defined %}
                {# Actions personnalisées #}
                {{ actions|raw }}
            {% endif %}
        </div>
    </div>
</header>
