{# En-tête de la façade de conception.
   - type : 'dashboard' | 'simple' | 'with_action' (défaut : 'simple')
   dashboard : user, homeUrl
   simple : title (texte ou HTML), subtitle (optionnel), backUrl, backTitle, actions (HTML, optionnel)
   with_action : title, icon (nom d'icône ou SVG brut), backUrl, backTitle, actionUrl, actionText,
                 actionColor ('green' | 'blue' | 'purple', défaut 'green') #}
{% import 'designer/_partials/macros.html.twig' as ui %}
{% import 'designer/_partials/icons.html.twig' as icons %}

{% set headerType = type|default('simple') %}
{% set backLink = 'w-10 h-10 rounded-xl flex items-center justify-center text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-500' %}

<header class="bg-white border-b border-slate-200">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex justify-between items-center gap-4">
            <div class="flex items-center gap-3 min-w-0">
                {% if headerType == 'dashboard' %}
                    {{ ui.badge(icons.path('chest'), 'bg-green-100 text-green-600', 'w-11 h-11', 'w-6 h-6') }}
                    <div>
                        <h1 class="text-2xl font-bold text-slate-800">Treasurely</h1>
                        <p class="text-sm text-slate-500">Espace de conception</p>
                    </div>
                {% else %}
                    <a href="{{ backUrl }}" class="{{ backLink }}" title="{{ backTitle|default('Retour') }}" aria-label="{{ backTitle|default('Retour') }}">
                        {{ ui.icon(icons.path('arrow_left'), 'w-6 h-6') }}
                    </a>
                    {% if headerType == 'with_action' %}
                        {% if icon is defined and icon starts with '<' %}
                            {{ icon|raw }}
                        {% elseif icon is defined %}
                            {{ ui.badge(icons.path(icon), iconTint|default('bg-green-100 text-green-600')) }}
                        {% endif %}
                        <h1 class="text-2xl font-bold text-slate-800 truncate">{{ title }}</h1>
                    {% else %}
                        <div class="min-w-0">
                            <h1 class="text-2xl font-bold text-slate-800">{{ title }}</h1>
                            {% if subtitle is defined and subtitle %}
                                <p class="text-sm text-slate-500">{{ subtitle }}</p>
                            {% endif %}
                        </div>
                    {% endif %}
                {% endif %}
            </div>

            {% if headerType == 'dashboard' %}
                <div class="flex items-center gap-3">
                    <span class="hidden sm:inline text-sm text-slate-600">Bonjour, <span class="font-semibold text-slate-800">{{ user.nickname }}</span></span>
                    <a href="{{ homeUrl }}" class="{{ backLink }}" title="Accueil" aria-label="Accueil">
                        {{ ui.icon(icons.path('home'), 'w-6 h-6') }}
                    </a>
                </div>
            {% elseif headerType == 'with_action' and actionUrl is defined and actionText is defined %}
                {% set variants = {green: 'primary', blue: 'blue', purple: 'purple'} %}
                <a href="{{ actionUrl }}" class="{{ ui.btn(variants[actionColor|default('green')]|default('primary')) }} shrink-0">
                    {{ ui.icon(icons.path('plus')) }}
                    <span>{{ actionText }}</span>
                </a>
            {% elseif actions is defined %}
                {{ actions|raw }}
            {% endif %}
        </div>
    </div>
</header>
