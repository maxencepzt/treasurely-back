{% extends 'base.html.twig' %}
{% import 'designer/_partials/macros.html.twig' as ui %}
{% import 'designer/_partials/icons.html.twig' as icons %}

{% block title %}Treasurely - Dashboard{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100">
        {{ include('designer/_partials/header.html.twig', {
            type: 'dashboard',
            user: app.user,
            homeUrl: path('app_home_index'),
        }) }}

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
            {# Quatre entrées, une par geste de conception #}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {% for entry in [
                    {url: path('app_designer_team'), title: 'Mes équipes', lead: 'Gérer mes équipes existantes', text: 'Consultez et gérez vos équipes, leurs membres et leurs chasses.', action: 'Accéder', icon: 'players', tint: 'bg-blue-100 text-blue-600', accent: 'group-hover:border-blue-300', link: 'text-blue-600'},
                    {url: path('app_designer_team_create'), title: 'Créer une équipe', lead: 'Former une nouvelle équipe', text: 'Créez une équipe et invitez des concepteurs à vous rejoindre.', action: 'Créer', icon: 'user_add', tint: 'bg-purple-100 text-purple-600', accent: 'group-hover:border-purple-300', link: 'text-purple-600'},
                    {url: path('app_designer_hunt'), title: 'Mes chasses', lead: 'Voir mes chasses au trésor', text: 'Parcourez vos chasses, suivez leurs participations et imprimez vos QR codes.', action: 'Voir', icon: 'chest', tint: 'bg-green-100 text-green-600', accent: 'group-hover:border-green-300', link: 'text-green-600'},
                    {url: path('app_designer_hunt_create'), title: 'Créer une chasse', lead: 'Concevoir une nouvelle aventure', text: 'Composez un parcours d\'énigmes pour vos joueurs.', action: 'Commencer', icon: 'plus', tint: 'bg-orange-100 text-orange-600', accent: 'group-hover:border-orange-300', link: 'text-orange-600'},
                ] %}
                    <a href="{{ entry.url }}" class="group block rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-500 focus-visible:ring-offset-2">
                        <div class="{{ ui.card('p-6 h-full transition-all group-hover:shadow-md') }} {{ entry.accent }}">
                            <div class="flex items-center gap-4 mb-4">
                                {{ ui.badge(icons.path(entry.icon), entry.tint, 'w-12 h-12', 'w-6 h-6') }}
                                <div class="min-w-0">
                                    <h2 class="text-xl font-bold text-slate-800">{{ entry.title }}</h2>
                                    <p class="text-sm text-slate-500">{{ entry.lead }}</p>
                                </div>
                            </div>
                            <p class="text-slate-600">{{ entry.text }}</p>
                            <div class="mt-4 inline-flex items-center gap-2 font-semibold {{ entry.link }}">
                                <span>{{ entry.action }}</span>
                                {{ ui.icon(icons.path('arrow_right'), 'w-5 h-5 transition-transform group-hover:translate-x-1') }}
                            </div>
                        </div>
                    </a>
                {% endfor %}
            </div>

            <div class="{{ ui.card('p-6') }}">
                <div class="mb-5">{{ ui.card_title('Statistiques rapides', icons.path('chart'), 'bg-slate-100 text-slate-600') }}</div>
                <dl class="grid grid-cols-2 md:grid-cols-5 gap-3">
                    {% for item in [
                        {label: 'Équipes', value: nb_teams, title: 'Équipes que vous possédez'},
                        {label: 'Membres', value: nb_members, title: 'Membres de vos équipes'},
                        {label: 'Chasses', value: nb_treasure_hunts, title: 'Chasses publiées par vos équipes'},
                        {label: 'Énigmes', value: nb_riddles, title: 'Énigmes de ces chasses'},
                        {label: 'Participations', value: nb_participations, title: 'Joueurs inscrits à ces chasses', attr: 'participations'},
                    ] %}
                        <div class="rounded-xl bg-slate-50 border border-slate-100 p-4" title="{{ item.title }}">
                            <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">{{ item.label }}</dt>
                            <dd class="text-2xl font-bold text-slate-900 tabular-nums mt-1"{% if item.attr is defined %} data-stat="{{ item.attr }}"{% endif %}>{{ item.value }}</dd>
                        </div>
                    {% endfor %}
                </dl>
            </div>
        </div>
    </div>
{% endblock %}
