{# Formulaire de chasse, création et modification. Variables :
   - mode : 'create' ou 'edit'
   - hunt : la chasse en édition, null en création
   - designerTeams, huntTypes : listes de choix
   - designerTeamId : équipe présélectionnée en création (optionnel)
   - riddles : tableaux RiddleMapper::toArray() en édition
   - submitUrl, cancelUrl, submitButtonText
   hunt-form.js lit l'URL, le jeton CSRF et le mode sur la balise form. #}
{% import 'designer/_partials/macros.html.twig' as ui %}
{% import 'designer/_partials/icons.html.twig' as icons %}
{% set hunt = hunt|default(null) %}

<form class="space-y-6"
      data-hunt-form
      data-mode="{{ mode }}"
      action="{{ submitUrl }}"
      data-csrf-token="{{ csrf_token(constant('App\\Controller\\Design\\DesignerHuntController::CSRF_TOKEN_ID')) }}">
    <div class="{{ ui.card('p-6') }}">
        <div class="mb-5">{{ ui.card_title('Informations de base', icons.path('info'), 'bg-green-100 text-green-600') }}</div>
        <div class="space-y-5">
            <div>
                {{ ui.label('hunt_name', 'Nom de la chasse', true) }}
                <input type="text" id="hunt_name" name="hunt_name" required maxlength="20" placeholder="Ex : Trésors de Reims" class="{{ ui.input() }}" value="{{ hunt ? hunt.title : '' }}" />
                <p class="mt-1 text-sm text-slate-500">20 caractères maximum.</p>
            </div>
            <div>
                {{ ui.label('hunt_description', 'Description', true) }}
                <textarea id="hunt_description" name="hunt_description" rows="3" required maxlength="3000" placeholder="Une courte description qui apparaîtra dans la liste des chasses…" class="{{ ui.textarea() }}">{{ hunt ? hunt.description : '' }}</textarea>
                <p id="hunt_description_hint" class="mt-1 text-sm text-slate-500">3000 caractères maximum.</p>
            </div>
            <div>
                <span class="block text-sm font-semibold text-slate-700 mb-2">Image de couverture</span>
                <div class="flex items-center gap-4">
                    <div id="hunt_image_preview" class="w-24 h-24 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-400 overflow-hidden shrink-0">
                        {% if hunt %}
                            <img src="{{ path('_api_/treasure_hunts/{id}/picture_get', {id: hunt.id}) }}" alt="" class="w-full h-full object-cover rounded-xl" />
                        {% else %}
                            {{ ui.icon(icons.path('map'), 'w-8 h-8') }}
                        {% endif %}
                    </div>
                    <label for="hunt_image" class="flex-1 cursor-pointer">
                        <div class="border-2 border-dashed border-slate-300 rounded-xl px-5 py-4 transition-colors hover:border-green-400 hover:bg-green-50 flex items-center gap-3">
                            {{ ui.icon(icons.path('image'), 'w-6 h-6 text-slate-400 shrink-0') }}
                            <div>
                                <p class="text-sm font-semibold text-slate-700">Cliquez ou glissez une image ici</p>
                                <p class="text-xs text-slate-500">PNG, JPG, GIF ou WebP, 5 Mo maximum</p>
                            </div>
                        </div>
                        <input type="file" id="hunt_image" name="hunt_image" accept="image/png,image/jpeg,image/gif,image/webp" class="hidden" />
                    </label>
                </div>
            </div>
        </div>
    </div>

    <div class="{{ ui.card('p-6') }}">
        <div class="mb-5">{{ ui.card_title('Configuration', icons.path('cog'), 'bg-blue-100 text-blue-600') }}</div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
            <div>
                {{ ui.label('hunt_team', 'Équipe', true) }}
                <select id="hunt_team" name="hunt_team" required class="{{ ui.input('cursor-pointer') }}">
                    <option value="">Sélectionnez une équipe</option>
                    {% set selectedTeamId = hunt ? hunt.designerTeam.id : designerTeamId|default(null) %}
                    {% for team in designerTeams %}
                        <option value="{{ team.id }}" {% if selectedTeamId == team.id %}selected{% endif %}>{{ team.name }}</option>
                    {% endfor %}
                </select>
                <p class="mt-1 text-sm text-slate-500">L'équipe propriétaire de cette chasse.</p>
            </div>
            <div>
                {{ ui.label('hunt_difficulty', 'Difficulté', true) }}
                {% set currentDifficulty = hunt ? hunt.difficulty : 2 %}
                <select id="hunt_difficulty" name="hunt_difficulty" required class="{{ ui.input('cursor-pointer') }}">
                    {% for level, label in {1: 'Facile', 2: 'Moyen', 3: 'Difficile'} %}
                        <option value="{{ level }}" {% if currentDifficulty == level %}selected{% endif %}>{{ label }}</option>
                    {% endfor %}
                </select>
            </div>
            <div>
                <span class="block text-sm font-semibold text-slate-700 mb-2">Type de chasse <span class="text-red-500" aria-hidden="true">*</span></span>
                <div class="space-y-2 max-h-48 overflow-y-auto border border-slate-300 rounded-xl p-3">
                    {% for huntType in huntTypes %}
                        <label class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-slate-50 cursor-pointer transition-colors">
                            <input type="checkbox" name="hunt_type[]" value="{{ huntType.id }}" class="hunt-type-checkbox w-5 h-5 accent-green-600 cursor-pointer" {% if hunt and huntType in hunt.huntType %}checked{% endif %} />
                            <span class="text-sm font-medium text-slate-700">{{ huntType.title }}</span>
                        </label>
                    {% endfor %}
                </div>
                <p class="mt-1 text-sm text-slate-500">Un ou plusieurs types.</p>
            </div>
            <div>
                {{ ui.label('hunt_duration', 'Durée estimée', true) }}
                <div class="flex items-center gap-2">
                    <input type="number" id="hunt_duration" name="hunt_duration" required min="5" step="1" placeholder="120" class="{{ ui.input() }}" value="{{ hunt ? hunt.estimatedTime : '' }}" />
                    <span class="text-sm text-slate-600 font-semibold shrink-0">minutes</span>
                </div>
            </div>
        </div>
    </div>

    {{ include('_partials/riddle_section.html.twig', {riddles: riddles|default([]), readonly: false}) }}

    <div class="{{ ui.card('p-6') }}">
        <div class="mb-5">{{ ui.card_title('Localisation', icons.path('pin'), 'bg-red-100 text-red-600') }}</div>
        {{ ui.label('hunt_city', 'Ville', true) }}
        <input type="text" id="hunt_city" name="hunt_city" required maxlength="30" placeholder="Reims, Lyon, Paris…" class="{{ ui.input() }}" value="{{ hunt ? hunt.location : '' }}" />
    </div>

    <div class="{{ ui.card('p-4 flex flex-wrap items-center justify-between gap-3') }}">
        <a href="{{ cancelUrl }}" class="{{ ui.btn('ghost') }}">Annuler</a>
        <div class="flex flex-wrap items-center gap-3">
            {% if not hunt or hunt.status == constant('App\\Entity\\TreasureHunt::STATE_DRAFT') %}
                <button type="submit" name="action" value="draft" class="{{ ui.btn('secondary') }}">Enregistrer le brouillon</button>
            {% endif %}
            <button type="submit" name="action" value="{{ hunt and hunt.status != constant('App\\Entity\\TreasureHunt::STATE_DRAFT') ? 'draft' : 'publish' }}" class="{{ ui.btn('primary') }}">
                {{ ui.icon(icons.path('check_plain')) }}
                <span>{{ submitButtonText }}</span>
            </button>
        </div>
    </div>
</form>

{{ include('_partials/riddle_modal.html.twig') }}
