{% extends 'base.html.twig' %}

{% block title %}Détails de la chasse - Treasurely{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100">
        {% set actionsHtml %}
            <div class="flex items-center space-x-3">
                <a href="/designer/hunts/1/edit" class="bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-semibold px-6 py-3 rounded-xl shadow-lg transform transition hover:scale-105 focus:outline-none focus:ring-4 focus:ring-blue-300 flex items-center space-x-2 cursor-pointer">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                    </svg>
                    <span>Modifier</span>
                </a>
            </div>
        {% endset %}

        {% set titleHtml %}
            <h1 class="text-2xl font-bold text-gray-800">Trésors du Vieux Lyon</h1>
            <div class="flex items-center space-x-3 mt-1">
                <span class="bg-blue-600 text-white text-xs font-semibold px-3 py-1 rounded-full flex items-center space-x-1">
                    <svg class="w-3 h-3 animate-pulse" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"></path>
                    </svg>
                    <span>En cours</span>
                </span>
                <span class="text-sm text-gray-500">Créée le 18/11/2024</span>
            </div>
        {% endset %}

        {{ include('designer/_partials/header.html.twig', {
            type: 'simple',
            title: titleHtml,
            backUrl: path('app_designer_hunt'),
            backTitle: 'Retour aux chasses',
            actions: actionsHtml,
        }) }}

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <!-- Bannière de la chasse -->
            <div class="bg-gradient-to-br from-blue-400 to-cyan-500 rounded-2xl shadow-2xl p-12 mb-8 relative overflow-hidden">
                <div class="absolute inset-0 opacity-10">
                    <div class="absolute inset-0 bg-pattern"></div>
                </div>
                <div class="relative z-10">
                    <h2 class="text-4xl font-bold text-white mb-4 drop-shadow-lg">Trésors du Vieux Lyon</h2>
                    <p class="text-xl text-white/90 max-w-3xl">
                        Explorez le quartier historique du Vieux Lyon à travers une série d'énigmes captivantes. Découvrez les secrets cachés dans les traboules et les ruelles pavées de ce patrimoine UNESCO.
                    </p>
                </div>
            </div>

            <!-- Statistiques rapides -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-purple-500">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-500 text-sm font-semibold uppercase">Énigmes</p>
                            <p class="text-3xl font-bold text-gray-800 mt-1">15</p>
                        </div>
                        <div class="p-3 bg-purple-100 rounded-lg">
                            <svg class="w-8 h-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-green-500">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-500 text-sm font-semibold uppercase">Participations</p>
                            <p class="text-3xl font-bold text-gray-800 mt-1">245</p>
                        </div>
                        <div class="p-3 bg-green-100 rounded-lg">
                            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                            </svg>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-orange-500">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-500 text-sm font-semibold uppercase">Durée moyenne</p>
                            <p class="text-3xl font-bold text-gray-800 mt-1">2h30</p>
                        </div>
                        <div class="p-3 bg-orange-100 rounded-lg">
                            <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-blue-500">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-500 text-sm font-semibold uppercase">Note moyenne</p>
                            <p class="text-3xl font-bold text-gray-800 mt-1">4.7</p>
                        </div>
                        <div class="p-3 bg-blue-100 rounded-lg">
                            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <!-- Colonne principale (2/3) -->
                <div class="lg:col-span-2 space-y-8">
                    <!-- Description détaillée -->
                    <div class="bg-white rounded-2xl shadow-lg p-6">
                        <h2 class="text-xl font-bold text-gray-800 mb-4 flex items-center space-x-2">
                            <svg class="w-6 h-6 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <span>Description détaillée</span>
                        </h2>
                        <div class="text-gray-600 leading-relaxed space-y-3">
                            <p>
                                Partez à la découverte du Vieux Lyon, ce quartier médiéval et Renaissance classé au patrimoine mondial de l'UNESCO. Cette chasse au trésor vous emmènera dans un voyage à travers le temps, à la recherche d'indices cachés dans les traboules mystérieuses, les cours intérieures secrètes et les façades historiques.
                            </p>
                            <p>
                                Vous résoudrez 15 énigmes variées qui vous permettront de mieux comprendre l'histoire fascinante de Lyon, de découvrir des anecdotes surprenantes et d'explorer des lieux souvent méconnus du grand public.
                            </p>
                            <p>
                                Que vous soyez amateur d'histoire, curieux de culture locale ou simplement en quête d'une activité originale, cette chasse saura vous captiver et vous surprendre à chaque étape de votre parcours.
                            </p>
                        </div>
                    </div>

                    <!-- Liste des énigmes -->
                    <div class="bg-white rounded-2xl shadow-lg p-6">
                        <div class="flex items-center justify-between mb-6">
                            <h2 class="text-xl font-bold text-gray-800 flex items-center space-x-2">
                                <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
                                </svg>
                                <span>Énigmes (15)</span>
                            </h2>
                            <button class="bg-purple-600 hover:bg-purple-700 text-white font-semibold px-4 py-2 rounded-lg shadow transform transition hover:scale-105 flex items-center space-x-2 cursor-pointer">
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                                </svg>
                                <span>Ajouter une énigme</span>
                            </button>
                        </div>

                        <div class="space-y-3">
                            <!-- Énigme 1 - GPS -->
                            <div class="p-4 bg-gradient-to-r from-blue-50 to-cyan-50 rounded-xl border-2 border-blue-200 hover:shadow-md transition cursor-pointer">
                                <div class="flex items-center justify-between mb-2">
                                    <div class="flex items-center space-x-3">
                                        <div class="w-8 h-8 bg-blue-600 rounded-lg flex items-center justify-center text-white font-bold text-sm">
                                            1
                                        </div>
                                        <div>
                                            <h3 class="font-bold text-gray-800">La Cathédrale Saint-Jean</h3>
                                            <p class="text-xs text-gray-500 flex items-center space-x-2">
                                                <span class="bg-blue-100 text-blue-700 px-2 py-0.5 rounded">GPS</span>
                                                <span>•</span>
                                                <span>10 points</span>
                                            </p>
                                        </div>
                                    </div>
                                    <button class="text-gray-600 hover:text-gray-800 p-2 rounded-lg hover:bg-white transition cursor-pointer">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"/>
                                        </svg>
                                    </button>
                                </div>
                                <p class="text-sm text-gray-600 ml-11">Trouvez l'emplacement exact de la cathédrale primatiale de Lyon...</p>
                            </div>

                            <!-- Énigme 2 - QCM -->
                            <div class="p-4 bg-gradient-to-r from-green-50 to-emerald-50 rounded-xl border-2 border-green-200 hover:shadow-md transition cursor-pointer">
                                <div class="flex items-center justify-between mb-2">
                                    <div class="flex items-center space-x-3">
                                        <div class="w-8 h-8 bg-green-600 rounded-lg flex items-center justify-center text-white font-bold text-sm">
                                            2
                                        </div>
                                        <div>
                                            <h3 class="font-bold text-gray-800">Histoire de la soierie</h3>
                                            <p class="text-xs text-gray-500 flex items-center space-x-2">
                                                <span class="bg-green-100 text-green-700 px-2 py-0.5 rounded">QCM</span>
                                                <span>•</span>
                                                <span>5 points</span>
                                            </p>
                                        </div>
                                    </div>
                                    <button class="text-gray-600 hover:text-gray-800 p-2 rounded-lg hover:bg-white transition cursor-pointer">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"/>
                                        </svg>
                                    </button>
                                </div>
                                <p class="text-sm text-gray-600 ml-11">En quelle année la soierie lyonnaise a-t-elle connu son apogée ?</p>
                            </div>

                            <!-- Énigme 3 - QR Code -->
                            <div class="p-4 bg-gradient-to-r from-purple-50 to-pink-50 rounded-xl border-2 border-purple-200 hover:shadow-md transition cursor-pointer">
                                <div class="flex items-center justify-between mb-2">
                                    <div class="flex items-center space-x-3">
                                        <div class="w-8 h-8 bg-purple-600 rounded-lg flex items-center justify-center text-white font-bold text-sm">
                                            3
                                        </div>
                                        <div>
                                            <h3 class="font-bold text-gray-800">Le secret de la traboule</h3>
                                            <p class="text-xs text-gray-500 flex items-center space-x-2">
                                                <span class="bg-purple-100 text-purple-700 px-2 py-0.5 rounded">QR Code</span>
                                                <span>•</span>
                                                <span>15 points</span>
                                            </p>
                                        </div>
                                    </div>
                                    <button class="text-gray-600 hover:text-gray-800 p-2 rounded-lg hover:bg-white transition cursor-pointer">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"/>
                                        </svg>
                                    </button>
                                </div>
                                <p class="text-sm text-gray-600 ml-11">Scannez le QR code caché dans la traboule pour découvrir l'indice suivant...</p>
                            </div>

                            <!-- Énigme 4 - Texte -->
                            <div class="p-4 bg-gradient-to-r from-orange-50 to-amber-50 rounded-xl border-2 border-orange-200 hover:shadow-md transition cursor-pointer">
                                <div class="flex items-center justify-between mb-2">
                                    <div class="flex items-center space-x-3">
                                        <div class="w-8 h-8 bg-orange-600 rounded-lg flex items-center justify-center text-white font-bold text-sm">
                                            4
                                        </div>
                                        <div>
                                            <h3 class="font-bold text-gray-800">L'énigme du Gourguillon</h3>
                                            <p class="text-xs text-gray-500 flex items-center space-x-2">
                                                <span class="bg-orange-100 text-orange-700 px-2 py-0.5 rounded">Texte</span>
                                                <span>•</span>
                                                <span>8 points</span>
                                            </p>
                                        </div>
                                    </div>
                                    <button class="text-gray-600 hover:text-gray-800 p-2 rounded-lg hover:bg-white transition cursor-pointer">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 5v.01M12 12v.01M12 19v.01M12 6a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2zm0 7a1 1 0 110-2 1 1 0 010 2z"/>
                                        </svg>
                                    </button>
                                </div>
                                <p class="text-sm text-gray-600 ml-11">Quel est le nom de la montée qui relie le Vieux Lyon à Fourvière ?</p>
                            </div>

                            <!-- Voir plus -->
                            <button class="w-full py-3 text-center text-purple-600 hover:text-purple-800 font-semibold hover:bg-purple-50 rounded-xl transition cursor-pointer">
                                Voir toutes les énigmes (11 de plus) →
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Colonne secondaire (1/3) -->
                <div class="space-y-6">
                    <!-- Informations de la chasse -->
                    <div class="bg-white rounded-2xl shadow-lg p-6">
                        <h2 class="text-xl font-bold text-gray-800 mb-4 flex items-center space-x-2">
                            <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                            </svg>
                            <span>Informations</span>
                        </h2>
                        <div class="space-y-3">
                            <div class="flex items-start space-x-3 text-sm">
                                <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                                </svg>
                                <div class="flex-1">
                                    <p class="text-gray-500">Équipe</p>
                                    <p class="font-semibold text-gray-800">Les Aventuriers</p>
                                </div>
                            </div>
                            <div class="flex items-start space-x-3 text-sm">
                                <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                                <div class="flex-1">
                                    <p class="text-gray-500">Créateur</p>
                                    <p class="font-semibold text-gray-800">John Doe</p>
                                </div>
                            </div>
                            <div class="flex items-start space-x-3 text-sm">
                                <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                </svg>
                                <div class="flex-1">
                                    <p class="text-gray-500">Date de création</p>
                                    <p class="font-semibold text-gray-800">18 novembre 2024</p>
                                </div>
                            </div>
                            <div class="flex items-start space-x-3 text-sm">
                                <svg class="w-5 h-5 text-gray-400 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                </svg>
                                <div class="flex-1">
                                    <p class="text-gray-500">Dernière modification</p>
                                    <p class="font-semibold text-gray-800">Il y a 3 heures</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Type de chasse -->
                    <div class="bg-white rounded-2xl shadow-lg p-6">
                        <h2 class="text-xl font-bold text-gray-800 mb-4 flex items-center space-x-2">
                            <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
                            </svg>
                            <span>Type de chasse</span>
                        </h2>
                        <div class="flex items-center space-x-3">
                            <div class="w-12 h-12 bg-gradient-to-br from-green-500 to-emerald-600 rounded-xl flex items-center justify-center">
                                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                </svg>
                            </div>
                            <div>
                                <p class="font-bold text-gray-800">Urbaine</p>
                                <p class="text-sm text-gray-500">Parcours en ville</p>
                            </div>
                        </div>
                    </div>

                    <!-- Actions rapides -->
                    <div class="bg-white rounded-2xl shadow-lg p-6">
                        <h2 class="text-xl font-bold text-gray-800 mb-4 flex items-center space-x-2">
                            <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                            </svg>
                            <span>Actions</span>
                        </h2>
                        <div class="space-y-2">
                            <button class="w-full text-left px-4 py-3 bg-blue-50 hover:bg-blue-100 text-blue-700 font-semibold rounded-xl transition flex items-center space-x-3 cursor-pointer">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                                <span>Aperçu de la chasse</span>
                            </button>
                            <button class="w-full text-left px-4 py-3 bg-green-50 hover:bg-green-100 text-green-700 font-semibold rounded-xl transition flex items-center space-x-3 cursor-pointer">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                                </svg>
                                <span>Dupliquer la chasse</span>
                            </button>
