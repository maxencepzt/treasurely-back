{% extends 'base.html.twig' %}
{% import 'designer/_partials/macros.html.twig' as ui %}

{% block title %}{{ treasureHunt.title }} - Treasurely{% endblock %}

{% set statusBadges = {
    draft: {label: 'Brouillon', class: 'bg-orange-600'},
    opened: {label: 'Ouverte', class: 'bg-green-600'},
    closed: {label: 'Fermée', class: 'bg-gray-600'},
} %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100">
        {% set actionsHtml %}
            {% if canEdit %}
                <a href="{{ path('app_designer_hunt_edit', {id: treasureHunt.id}) }}" class="bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-semibold px-6 py-3 rounded-xl shadow-lg transform transition hover:scale-105 flex items-center space-x-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                    </svg>
                    <span>Modifier</span>
                </a>
            {% endif %}
        {% endset %}

        {% set titleHtml %}
            <h1 class="text-2xl font-bold text-gray-800">{{ treasureHunt.title }}</h1>
            <div class="flex items-center space-x-3 mt-1">
                {% set badge = statusBadges[treasureHunt.status]|default({label: treasureHunt.status, class: 'bg-gray-600'}) %}
                <span class="{{ badge.class }} text-white text-xs font-semibold px-3 py-1 rounded-full">{{ badge.label }}</span>
                <span class="text-sm text-gray-500">Créée le {{ treasureHunt.createdAt|date('d/m/Y') }}, modifiée {{ treasureHunt.updatedAt|ago }}</span>
            </div>
        {% endset %}

        {{ include('designer/_partials/header.html.twig', {
            type: 'simple',
            title: titleHtml,
            backUrl: path('app_designer_hunt'),
            backTitle: 'Retour aux chasses',
            actions: actionsHtml,
        }) }}

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="bg-gradient-to-br from-blue-400 to-cyan-500 rounded-2xl shadow-2xl p-12 mb-8 relative overflow-hidden">
                <img src="{{ path('_api_/treasure_hunts/{id}/picture_get', {id: treasureHunt.id}) }}" alt="" class="absolute inset-0 w-full h-full object-cover opacity-25" />
                <div class="relative z-10">
                    <h2 class="text-4xl font-bold text-white mb-4 drop-shadow-lg">{{ treasureHunt.title }}</h2>
                    <p class="text-xl text-white/90 max-w-3xl">{{ ui.excerpt(treasureHunt.description, 250) }}</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                {% for stat in [
                    {label: 'Énigmes', value: riddles|length, color: 'purple'},
                    {label: 'Participations', value: treasureHunt.participateHunts|length, color: 'green'},
                    {label: 'Durée estimée', value: treasureHunt.estimatedTime ~ ' min', color: 'orange'},
                ] %}
                    <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-{{ stat.color }}-500">
                        <p class="text-gray-500 text-sm font-semibold uppercase">{{ stat.label }}</p>
                        <p class="text-3xl font-bold text-gray-800 mt-1">{{ stat.value }}</p>
                    </div>
                {% endfor %}
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <div class="lg:col-span-2 space-y-8">
                    <div class="bg-white rounded-2xl shadow-lg p-6">
                        <h2 class="text-xl font-bold text-gray-800 mb-4">Description</h2>
                        <p class="text-gray-600 leading-relaxed whitespace-pre-line">{{ treasureHunt.description }}</p>
                    </div>

                    {{ include('_partials/riddle_section.html.twig', {riddles: riddles, readonly: true, huntId: treasureHunt.id}) }}
                </div>

                <div class="space-y-6">
                    <div class="bg-white rounded-2xl shadow-lg p-6">
                        <h2 class="text-xl font-bold text-gray-800 mb-4">Informations</h2>
                        <dl class="space-y-3 text-sm">
                            <div><dt class="text-gray-500">Équipe</dt><dd class="font-semibold text-gray-800">{{ treasureHunt.designerTeam.name }}</dd></div>
                            <div><dt class="text-gray-500">Créateur</dt><dd class="font-semibold text-gray-800">{{ treasureHunt.owner.firstname }} {{ treasureHunt.owner.lastname }}</dd></div>
                            <div><dt class="text-gray-500">Localisation</dt><dd class="font-semibold text-gray-800">{{ treasureHunt.location }}</dd></div>
                            <div><dt class="text-gray-500">Difficulté</dt><dd class="font-semibold text-gray-800">{{ ui.flames(treasureHunt.difficulty, 'w-5 h-5') }}</dd></div>
                            <div>
                                <dt class="text-gray-500">Type{{ treasureHunt.huntType|length > 1 ? 's' }} de chasse</dt>
                                <dd class="flex flex-wrap gap-2 mt-1">
                                    {% for type in treasureHunt.huntType %}
                                        <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm font-semibold">{{ type.title }}</span>
                                    {% else %}
                                        <span class="text-gray-400">Aucun</span>
                                    {% endfor %}
                                </dd>
                            </div>
                        </dl>
                    </div>

                    {% if canEdit and transitions|length > 0 %}
                        {% set transitionLabels = {
                            close: {label: 'Fermer la chasse', class: 'bg-orange-50 hover:bg-orange-100 text-orange-700', confirm: 'Fermer la chasse ? Les joueurs ne pourront plus y participer.'},
                            republish: {label: 'Rouvrir la chasse', class: 'bg-green-50 hover:bg-green-100 text-green-700', confirm: ''},
                        } %}
                        <div class="bg-white rounded-2xl shadow-lg p-6">
                            <h2 class="text-xl font-bold text-gray-800 mb-4">Actions</h2>
                            <div class="space-y-2">
                                {% for transition in transitions|filter(t => transitionLabels[t] is defined) %}
                                    <button type="button"
                                            data-transition-url="{{ path('api_designer_hunt_transition', {id: treasureHunt.id, transition: transition}) }}"
                                            data-csrf-token="{{ csrf_token(constant('App\\Controller\\Design\\DesignerHuntController::CSRF_TOKEN_ID')) }}"
                                            data-confirm="{{ transitionLabels[transition].confirm }}"
                                            class="w-full text-left px-4 py-3 {{ transitionLabels[transition].class }} font-semibold rounded-xl transition cursor-pointer">
                                        {{ transitionLabels[transition].label }}
                                    </button>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {{ include('_partials/toast.html.twig', {id: 'globalToast'}) }}
    {{ importmap('hunt-details') }}
{% endblock %}
