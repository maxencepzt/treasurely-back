{% extends 'base.html.twig' %}
{% import 'designer/_partials/macros.html.twig' as ui %}

{% block title %}{{ treasureHunt.title }} - Treasurely{% endblock %}

{% set statusBadges = {
    draft: {label: 'Brouillon', class: 'bg-orange-600'},
    opened: {label: 'Ouverte', class: 'bg-green-600'},
    closed: {label: 'Fermée', class: 'bg-gray-600'},
} %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100">
        {% set actionsHtml %}
            {% if canEdit %}
                <a href="{{ path('app_designer_hunt_edit', {id: treasureHunt.id}) }}" class="{{ ui.btn('blue') }}">
                    {{ ui.icon('M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z') }}
                    <span>Modifier</span>
                </a>
            {% endif %}
        {% endset %}

        {% set titleHtml %}
            <h1 class="text-2xl font-bold text-gray-800">{{ treasureHunt.title }}</h1>
            <div class="flex items-center space-x-3 mt-1">
                {% set badge = statusBadges[treasureHunt.status]|default({label: treasureHunt.status, class: 'bg-gray-600'}) %}
                <span class="{{ badge.class }} text-white text-xs font-semibold px-3 py-1 rounded-full">{{ badge.label }}</span>
                <span class="text-sm text-gray-500">Créée le {{ treasureHunt.createdAt|date('d/m/Y') }}, modifiée {{ treasureHunt.updatedAt|ago }}</span>
            </div>
        {% endset %}

        {{ include('designer/_partials/header.html.twig', {
            type: 'simple',
            title: titleHtml,
            backUrl: path('app_designer_hunt'),
            backTitle: 'Retour aux chasses',
            actions: actionsHtml,
        }) }}

        {# Une seule recette de carte : bord fin, ombre discrète, rayon et marges constants. #}
        {% set card = 'bg-white rounded-2xl border border-slate-200 shadow-sm p-6' %}
        {% set cardTitle = 'text-lg font-bold text-slate-800' %}
        {% set iconBadge = 'w-9 h-9 rounded-xl flex items-center justify-center shrink-0' %}
        {% set icons = {
            riddles: 'M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
            players: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
            clock: 'M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z',
            text: 'M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z',
            info: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
            ranking: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
            bolt: 'M13 10V3L4 14h7v7l9-11h-7z',
        } %}
        {% set rankStyles = {
            1: 'bg-amber-100 text-amber-800',
            2: 'bg-slate-200 text-slate-700',
            3: 'bg-orange-100 text-orange-800',
        } %}

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="bg-gradient-to-br from-blue-400 to-cyan-500 rounded-2xl shadow-2xl p-12 mb-8 relative overflow-hidden">
                <img src="{{ path('_api_/treasure_hunts/{id}/picture_get', {id: treasureHunt.id}) }}" alt="" class="absolute inset-0 w-full h-full object-cover opacity-25" />
                <div class="relative z-10">
                    <h2 class="text-4xl font-bold text-white mb-4 drop-shadow-lg">{{ treasureHunt.title }}</h2>
                    <p class="text-xl text-white/90 max-w-3xl">{{ ui.excerpt(treasureHunt.description, 250) }}</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                {% for stat in [
                    {label: 'Énigmes', value: riddles|length, hint: 'dans le parcours', icon: icons.riddles, tint: 'bg-purple-100 text-purple-600'},
                    {label: 'Participations', value: stats.participations, hint: stats.finished ~ ' terminée' ~ (stats.finished > 1 ? 's'), icon: icons.players, tint: 'bg-green-100 text-green-600'},
                    {label: 'Durée estimée', value: treasureHunt.estimatedTime ~ ' min', hint: 'annoncée aux joueurs', icon: icons.clock, tint: 'bg-orange-100 text-orange-600'},
                ] %}
                    {{ ui.stat(stat.label, stat.value, stat.hint, stat.icon, stat.tint) }}
                {% endfor %}
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                <div class="lg:col-span-2 space-y-8">
                    <div class="{{ card }}">
                        <div class="flex items-center gap-3 mb-5">
                            <div class="{{ iconBadge }} bg-blue-100 text-blue-600">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="{{ icons.text }}"></path></svg>
                            </div>
                            <h2 class="{{ cardTitle }}">Description</h2>
                        </div>
                        <p class="text-slate-600 leading-relaxed whitespace-pre-line">{{ treasureHunt.description }}</p>
                    </div>

                    {{ include('_partials/riddle_section.html.twig', {riddles: riddles, readonly: true, huntId: treasureHunt.id}) }}

                    <div class="{{ card }}">
                        <div class="flex items-center gap-3 mb-5">
                            <div class="{{ iconBadge }} bg-green-100 text-green-600">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="{{ icons.ranking }}"></path></svg>
                            </div>
                            <h2 class="{{ cardTitle }}">Participations</h2>
                        </div>
                        <dl class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
                            {% for item in [
                                {label: 'Inscrits', value: stats.participations, stat: 'participations'},
                                {label: 'Chasses terminées', value: stats.finished, stat: 'finished'},
                                {label: 'Score moyen', value: stats.averageScore is null ? '–' : stats.averageScore, stat: 'average-score'},
                                {label: 'Temps moyen', value: stats.averageTime is null ? '–' : stats.averageTime|duration, stat: 'average-time'},
                            ] %}
                                <div class="rounded-xl bg-slate-50 border border-slate-100 p-4">
                                    <dt class="text-xs font-semibold uppercase tracking-wide text-slate-500">{{ item.label }}</dt>
                                    <dd class="text-2xl font-bold text-slate-900 tabular-nums mt-1" data-stat="{{ item.stat }}">{{ item.value }}</dd>
                                </div>
                            {% endfor %}
                        </dl>
                        {% if ranking is empty %}
                            <p class="text-slate-500 text-sm">Personne n'a encore terminé cette chasse.</p>
                        {% else %}
                            <div class="overflow-x-auto -mx-6 px-6">
                                <table class="w-full text-sm" data-ranking>
                                    <thead>
                                        <tr class="text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                                            <th class="py-2 pr-3 font-semibold">#</th>
                                            <th class="py-2 pr-3 font-semibold">Joueur</th>
                                            <th class="py-2 pr-3 font-semibold">Équipe</th>
                                            <th class="py-2 pr-3 font-semibold text-right">Score</th>
                                            <th class="py-2 pr-3 font-semibold text-right">Temps</th>
                                            <th class="py-2 font-semibold text-right">Arrivée</th>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100">
                                        {% for participation in ranking %}
                                            <tr class="hover:bg-slate-50 transition-colors">
                                                <td class="py-2.5 pr-3">
                                                    <span class="inline-flex w-7 h-7 items-center justify-center rounded-full text-xs font-bold tabular-nums {{ rankStyles[loop.index]|default('text-slate-500') }}">{{ loop.index }}</span>
                                                </td>
                                                <td class="py-2.5 pr-3 font-semibold text-slate-800">{{ participation.hunter.nickname }}</td>
                                                <td class="py-2.5 pr-3 text-slate-600">{{ participation.playerTeam ? participation.playerTeam.name : '–' }}</td>
                                                <td class="py-2.5 pr-3 text-right font-semibold text-green-700 tabular-nums">{{ participation.score }}</td>
                                                <td class="py-2.5 pr-3 text-right text-slate-600 tabular-nums">{{ participation.time|duration }}</td>
                                                <td class="py-2.5 text-right text-slate-500">{{ participation.lastParticipate|ago }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <div class="space-y-6">
                    <div class="{{ card }}">
                        <div class="flex items-center gap-3 mb-3">
                            <div class="{{ iconBadge }} bg-slate-100 text-slate-600">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="{{ icons.info }}"></path></svg>
                            </div>
                            <h2 class="{{ cardTitle }}">Informations</h2>
                        </div>
                        <dl class="divide-y divide-slate-100 text-sm">
                            {% for row in [
                                {label: 'Équipe', value: treasureHunt.designerTeam.name},
                                {label: 'Créateur', value: treasureHunt.owner.firstname ~ ' ' ~ treasureHunt.owner.lastname},
                                {label: 'Localisation', value: treasureHunt.location},
                            ] %}
                                <div class="flex items-start justify-between gap-4 py-3">
                                    <dt class="text-slate-500">{{ row.label }}</dt>
                                    <dd class="font-semibold text-slate-800 text-right">{{ row.value }}</dd>
                                </div>
                            {% endfor %}
                            <div class="flex items-center justify-between gap-4 py-3">
                                <dt class="text-slate-500">Difficulté</dt>
                                <dd>{{ ui.flames(treasureHunt.difficulty, 'w-5 h-5') }}</dd>
                            </div>
                            <div class="py-3">
                                <dt class="text-slate-500 mb-2">Type{{ treasureHunt.huntType|length > 1 ? 's' }} de chasse</dt>
                                <dd class="flex flex-wrap gap-2">
                                    {% for type in treasureHunt.huntType %}
                                        <span class="bg-green-50 text-green-700 border border-green-100 px-3 py-1 rounded-full text-xs font-semibold">{{ type.title }}</span>
                                    {% else %}
                                        <span class="text-slate-400">Aucun</span>
                                    {% endfor %}
                                </dd>
                            </div>
                        </dl>
                    </div>

                    {% if canEdit and transitions|length > 0 %}
                        {% set transitionLabels = {
                            close: {label: 'Fermer la chasse', class: 'bg-orange-50 hover:bg-orange-100 text-orange-700 focus-visible:ring-orange-500', confirm: 'Fermer la chasse ? Les joueurs ne pourront plus y participer.'},
                            republish: {label: 'Rouvrir la chasse', class: 'bg-green-50 hover:bg-green-100 text-green-700 focus-visible:ring-green-500', confirm: ''},
                        } %}
                        <div class="{{ card }}">
                            <div class="flex items-center gap-3 mb-3">
                                <div class="{{ iconBadge }} bg-orange-100 text-orange-600">
                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="{{ icons.bolt }}"></path></svg>
                                </div>
                                <h2 class="{{ cardTitle }}">Actions</h2>
                            </div>
                            <div class="space-y-2">
                                {% for transition in transitions|filter(t => transitionLabels[t] is defined) %}
                                    <button type="button"
                                            data-transition-url="{{ path('api_designer_hunt_transition', {id: treasureHunt.id, transition: transition}) }}"
                                            data-csrf-token="{{ csrf_token(constant('App\\Controller\\Design\\DesignerHuntController::CSRF_TOKEN_ID')) }}"
                                            data-confirm="{{ transitionLabels[transition].confirm }}"
                                            class="w-full text-left px-4 py-3 {{ transitionLabels[transition].class }} font-semibold rounded-xl transition-colors cursor-pointer focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2">
                                        {{ transitionLabels[transition].label }}
                                    </button>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    {{ include('_partials/toast.html.twig', {id: 'globalToast'}) }}
    {{ importmap('hunt-details') }}
{% endblock %}
