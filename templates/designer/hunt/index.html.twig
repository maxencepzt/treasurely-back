{% extends 'base.html.twig' %}
{% import 'designer/_partials/macros.html.twig' as ui %}
{% import 'designer/_partials/icons.html.twig' as icons %}

{% block title %}Mes chasses - Treasurely{% endblock %}

{% set statusBadges = {
    draft: {label: 'Brouillon', class: 'bg-orange-600'},
    opened: {label: 'Ouverte', class: 'bg-green-600'},
    closed: {label: 'Fermée', class: 'bg-gray-600'},
} %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100">
        {{ include('designer/_partials/header.html.twig', {
            type: 'with_action',
            title: 'Mes chasses',
            icon: 'chest',
            backUrl: path('app_designer_dashboard'),
            actionUrl: path('app_designer_hunt_create'),
            actionText: 'Créer une chasse',
            actionColor: 'green',
        }) }}

        {# Même recette de carte que la page de détails : bord fin, ombre discrète, badge d'icône. #}
        {% set card = 'bg-white rounded-2xl border border-slate-200 shadow-sm' %}
        {% set iconBadge = 'w-9 h-9 rounded-xl flex items-center justify-center shrink-0' %}

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-8">
                {% for stat in [
                    {label: 'Total', value: treasureHunts|length, hint: 'chasse' ~ (treasureHunts|length > 1 ? 's') ~ ' créée' ~ (treasureHunts|length > 1 ? 's'), icon: icons.path('map'), tint: 'bg-green-100 text-green-600'},
                    {label: 'Ouvertes', value: nbOpened, hint: 'jouables maintenant', icon: icons.path('check'), tint: 'bg-blue-100 text-blue-600'},
                    {label: 'Fermées', value: nbClosed, hint: 'plus de nouveaux joueurs', icon: icons.path('lock'), tint: 'bg-slate-100 text-slate-600'},
                    {label: 'Brouillons', value: nbDrafts, hint: 'à publier', icon: icons.path('pencil'), tint: 'bg-orange-100 text-orange-600'},
                ] %}
                    {{ ui.stat(stat.label, stat.value, stat.hint, stat.icon, stat.tint) }}
                {% endfor %}
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                {% for hunt in treasureHunts %}
                    {% set badge = statusBadges[hunt.status]|default({label: hunt.status, class: 'bg-gray-600'}) %}
                    {% set nbRiddles = hunt.riddles|length %}
                    {% set nbParticipations = participations[hunt.id]|default(0) %}
                    <a href="{{ path('app_designer_hunt_details', {id: hunt.id}) }}"
                       class="group block rounded-2xl focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-500 focus-visible:ring-offset-2"
                       aria-label="Voir la chasse {{ hunt.title }}">
                        <article class="{{ card }} overflow-hidden h-full flex flex-col transition-all group-hover:shadow-md group-hover:border-green-300">
                            <div class="aspect-video bg-gradient-to-br from-blue-50 to-cyan-50 relative overflow-hidden">
                                <img src="{{ path('_api_/treasure_hunts/{id}/picture_get', {id: hunt.id}) }}" alt="" loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
                                <div class="absolute inset-0 bg-gradient-to-t from-slate-900/70 via-slate-900/10 to-transparent" aria-hidden="true"></div>
                                <span class="absolute top-4 right-4 {{ badge.class }} text-white text-xs font-semibold px-3 py-1 rounded-full">{{ badge.label }}</span>
                                <h3 class="absolute bottom-4 left-5 right-5 text-2xl font-bold text-white drop-shadow">{{ hunt.title }}</h3>
                            </div>
                            <div class="p-5 flex-1 flex flex-col">
                                <p class="text-slate-600 text-sm mb-4">{{ ui.excerpt(hunt.description, 150) }}</p>
                                <ul class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-slate-600 mb-4">
                                    <li class="inline-flex items-center gap-1.5">
                                        <svg class="w-4 h-4 text-purple-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="{{ icons.path('riddle') }}"></path></svg>
                                        <span class="tabular-nums">{{ nbRiddles }} énigme{{ nbRiddles > 1 ? 's' }}</span>
                                    </li>
                                    <li class="inline-flex items-center gap-1.5">
                                        <svg class="w-4 h-4 text-green-500" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="{{ icons.path('players') }}"></path></svg>
                                        <span class="tabular-nums">{{ nbParticipations }} participation{{ nbParticipations > 1 ? 's' }}</span>
                                    </li>
                                    <li class="inline-flex items-center gap-1.5">{{ ui.flames(hunt.difficulty) }}</li>
                                    <li class="inline-flex items-center gap-1.5">
                                        <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="{{ icons.path('team') }}"></path></svg>
                                        <span>{{ hunt.designerTeam.name }}</span>
                                    </li>
                                </ul>
                                <div class="mt-auto flex items-center justify-between pt-4 border-t border-slate-100 text-sm text-slate-500">
                                    <span>{{ hunt.owner.firstname }} {{ hunt.owner.lastname }}</span>
                                    <span>Modifiée {{ hunt.updatedAt|ago }}</span>
                                </div>
                            </div>
                        </article>
                    </a>
                {% else %}
                    <div class="lg:col-span-2 text-center py-16 px-6 bg-white rounded-2xl border-2 border-dashed border-slate-200">
                        <div class="{{ iconBadge }} bg-green-100 text-green-600 mx-auto mb-4 w-12 h-12">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="{{ icons.path('map') }}"></path></svg>
                        </div>
                        <h3 class="text-xl font-semibold text-slate-700 mb-2">Aucune chasse pour le moment</h3>
                        <p class="text-slate-500 mb-6">Créez votre première chasse au trésor pour commencer l'aventure.</p>
                        <a href="{{ path('app_designer_hunt_create') }}" class="inline-flex items-center gap-2 bg-gradient-to-r from-green-600 to-emerald-700 hover:from-green-700 hover:to-emerald-800 text-white font-semibold px-6 py-3 rounded-xl shadow-lg transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-500 focus-visible:ring-offset-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="{{ icons.path('plus') }}"></path></svg>
                            <span>Créer ma première chasse</span>
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}
