{% extends 'base.html.twig' %}
{% import 'designer/_partials/macros.html.twig' as ui %}

{% block title %}Mes chasses - Treasurely{% endblock %}

{% set statusBadges = {
    draft: {label: 'Brouillon', class: 'bg-orange-600'},
    opened: {label: 'Ouverte', class: 'bg-green-600'},
    closed: {label: 'Fermée', class: 'bg-gray-600'},
} %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100">
        {{ include('designer/_partials/header.html.twig', {
            type: 'with_action',
            title: 'Mes chasses',
            icon: '<svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 12.4984L14 12.4984M3 12.4984L10 12.4984M7 4.5V19.4984M17 4.5V19.4984M6.2 19.5H17.8C18.9201 19.5 19.4802 19.5 19.908 19.282C20.2843 19.0903 20.5903 18.7843 20.782 18.408C21 17.9802 21 17.4201 21 16.3V10.9C21 8.65979 21 7.53968 20.564 6.68404C20.1805 5.93139 19.5686 5.31947 18.816 4.93597C17.9603 4.5 16.8402 4.5 14.6 4.5H9.4C7.15979 4.5 6.03968 4.5 5.18404 4.93597C4.43139 5.31947 3.81947 5.93139 3.43597 6.68404C3 7.53968 3 8.65979 3 10.9V16.3C3 17.4201 3 17.9802 3.21799 18.408C3.40973 18.7843 3.71569 19.0903 4.09202 19.282C4.51984 19.5 5.07989 19.5 6.2 19.5ZM10 10.4984H14V14.4984H10V10.4984Z" stroke-width="2" stroke-linejoin="round"></path></svg>',
            backUrl: path('app_designer_dashboard'),
            actionUrl: path('app_designer_hunt_create'),
            actionText: 'Créer une chasse',
            actionColor: 'green',
        }) }}

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-8">
                {% for stat in [
                    {label: 'Total', value: treasureHunts|length, color: 'green'},
                    {label: 'Ouvertes', value: nbOpened, color: 'blue'},
                    {label: 'Fermées', value: nbClosed, color: 'gray'},
                    {label: 'Brouillons', value: nbDrafts, color: 'orange'},
                ] %}
                    <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-{{ stat.color }}-500">
                        <p class="text-gray-500 text-sm font-semibold uppercase">{{ stat.label }}</p>
                        <p class="text-3xl font-bold text-gray-800 mt-1">{{ stat.value }}</p>
                    </div>
                {% endfor %}
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                {% for hunt in treasureHunts %}
                    {% set badge = statusBadges[hunt.status]|default({label: hunt.status, class: 'bg-gray-600'}) %}
                    <a href="{{ path('app_designer_hunt_details', {id: hunt.id}) }}" class="group">
                        <div class="bg-white rounded-2xl shadow-lg hover:shadow-2xl transform transition hover:scale-105 overflow-hidden">
                            <div class="h-48 bg-gradient-to-br from-blue-50 to-cyan-50 relative">
                                <img src="{{ path('_api_/treasure_hunts/{id}/picture_get', {id: hunt.id}) }}" alt="" class="absolute inset-0 w-full h-full object-cover opacity-75" />
                                <span class="absolute top-4 right-4 {{ badge.class }} text-white text-xs font-semibold px-3 py-1 rounded-full">{{ badge.label }}</span>
                                <h3 class="absolute bottom-4 left-4 right-4 text-2xl font-bold text-white drop-shadow-lg">{{ hunt.title }}</h3>
                            </div>
                            <div class="p-6">
                                <p class="text-gray-600 text-sm mb-4">{{ ui.excerpt(hunt.description, 150) }}</p>
                                <div class="flex items-center justify-between text-sm text-gray-600 mb-4">
                                    <span>{{ hunt.riddles|length }} énigme{{ hunt.riddles|length > 1 ? 's' }}</span>
                                    {{ ui.flames(hunt.difficulty) }}
                                    <span>{{ hunt.designerTeam.name }}</span>
                                </div>
                                <div class="flex items-center justify-between pt-4 border-t border-gray-200 text-sm text-gray-500">
                                    <span>{{ hunt.owner.firstname }} {{ hunt.owner.lastname }}</span>
                                    <span>Modifiée {{ hunt.updatedAt|ago }}</span>
                                </div>
                            </div>
                        </div>
                    </a>
                {% else %}
                    <div class="lg:col-span-2 text-center py-16 bg-white rounded-2xl shadow-lg">
                        <h3 class="text-xl font-semibold text-gray-600 mb-2">Aucune chasse pour le moment</h3>
                        <p class="text-gray-500 mb-6">Créez votre première chasse au trésor pour commencer l'aventure.</p>
                        <a href="{{ path('app_designer_hunt_create') }}" class="inline-flex items-center space-x-2 bg-gradient-to-r from-green-600 to-emerald-700 hover:from-green-700 hover:to-emerald-800 text-white font-semibold px-6 py-3 rounded-xl shadow-lg transform transition hover:scale-105">
                            <span>Créer ma première chasse</span>
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}
