{% extends 'base.html.twig' %}

{% block title %}Mes chasses - Treasurely{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100">
        {{ include('designer/_partials/header.html.twig', {
            type: 'with_action',
            title: 'Mes Chasses',
            icon: '<svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 12.4984L14 12.4984M3 12.4984L10 12.4984M7 4.5V19.4984M17 4.5V19.4984M6.2 19.5H17.8C18.9201 19.5 19.4802 19.5 19.908 19.282C20.2843 19.0903 20.5903 18.7843 20.782 18.408C21 17.9802 21 17.4201 21 16.3V10.9C21 8.65979 21 7.53968 20.564 6.68404C20.1805 5.93139 19.5686 5.31947 18.816 4.93597C17.9603 4.5 16.8402 4.5 14.6 4.5H9.4C7.15979 4.5 6.03968 4.5 5.18404 4.93597C4.43139 5.31947 3.81947 5.93139 3.43597 6.68404C3 7.53968 3 8.65979 3 10.9V16.3C3 17.4201 3 17.9802 3.21799 18.408C3.40973 18.7843 3.71569 19.0903 4.09202 19.282C4.51984 19.5 5.07989 19.5 6.2 19.5ZM10 10.4984H14V14.4984H10V10.4984Z" stroke-width="2" stroke-linejoin="round"></path></svg>',
            backUrl: path('app_designer_dashboard'),
            actionUrl: path('app_designer_hunt_create'),
            actionText: 'Créer une chasse',
            actionColor: 'green',
        }) }}

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <!-- Filtres et recherche -->
            <div class="bg-white rounded-2xl shadow-lg p-6 mb-8">
                <div class="flex flex-col md:flex-row md:items-center md:justify-between space-y-4 md:space-y-0 gap-4">
                    <!-- Recherche -->
                    <div class="flex items-center space-x-3 flex-1">
                        <label for="search">Rechercher :</label>
                        <div class="relative flex-grow-1">
                            <input
                                    id="search"
                                    type="text"
                                    placeholder="Rechercher une chasse..."
                                    class="w-full px-4 py-3 pl-12 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-transparent transition"
                            />
                            <svg class="w-5 h-5 text-gray-400 absolute left-4 top-1/2 transform -translate-y-1/2"
                                 fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                            </svg>
                        </div>
                    </div>

                    <!-- Filtres -->
                    <div class="flex items-center">
                        <label class="space-x-2">
                            Filtrer par :&nbsp;
                            <select class="px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-transparent transition cursor-pointer">
                                <option>Tous les statuts</option>
                                <option>En cours</option>
                                <option>Fermée</option>
                                <option>Brouillon</option>
                            </select>

                            <select class="px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-transparent transition cursor-pointer">
                                <option>Toutes les équipes</option>
                                <option>Les Aventuriers</option>
                                <option>Team Rocket</option>
                                <option>Explorateurs IUT</option>
                            </select>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Statistiques rapides -->
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
                <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-green-500">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-500 text-sm font-semibold uppercase">Total</p>
                            <p class="text-3xl font-bold text-gray-800 mt-1">{{ treasureHunts|length }}</p>
                        </div>
                        <div class="p-3 bg-green-100 rounded-lg">
                            <svg class="w-8 h-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
                            </svg>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-blue-500">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-500 text-sm font-semibold uppercase">En cours</p>
                            <p class="text-3xl font-bold text-gray-800 mt-1">{{ nbOpened }}</p>
                        </div>
                        <div class="p-3 bg-blue-100 rounded-lg">
                            <svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                            </svg>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-gray-500">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-500 text-sm font-semibold uppercase">Fermées</p>
                            <p class="text-3xl font-bold text-gray-800 mt-1">{{ nbClosed }}</p>
                        </div>
                        <div class="p-3 bg-gray-100 rounded-lg">
                            <svg class="w-8 h-8 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                            </svg>
                        </div>
                    </div>
                </div>

                <div class="bg-white rounded-xl shadow-lg p-6 border-l-4 border-orange-500">
                    <div class="flex items-center justify-between">
                        <div>
                            <p class="text-gray-500 text-sm font-semibold uppercase">Brouillons</p>
                            <p class="text-3xl font-bold text-gray-800 mt-1">{{ nbDrafts }}</p>
                        </div>
                        <div class="p-3 bg-orange-100 rounded-lg">
                            <svg class="w-8 h-8 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path>
                            </svg>
                        </div>
                    </div>
                </div>
            </div>

            {% set bgColors = [
                'from-blue-50 to-cyan-50',
                'from-green-50 to-emerald-50',
                'from-purple-50 to-pink-50',
                'from-orange-50 to-amber-50',
                'from-pink-50 to-rose-50',
                'from-indigo-50 to-blue-50',
                'from-red-50 to-pink-50',
                'from-teal-50 to-cyan-50',
            ] %}

            <!-- Liste des chasses -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                {% for hunt in treasureHunts %}
                    <a href="{{ path('app_designer_hunt_details', {id: hunt.id}) }}" class="group cursor-pointer">
                        <div class="bg-white rounded-2xl shadow-lg hover:shadow-2xl transform transition hover:scale-105 overflow-hidden">
                            <!-- Image de couverture -->
                            <div class="h-48 bg-gradient-to-br {{ bgColors[loop.index0 % bgColors|length] }} relative">
                                <img src="{{ path('_api_/treasure_hunts/{id}/picture_delete', {id: hunt.id}) }}"
                                     alt="{{ hunt.title }}"
                                     class="absolute inset-0 w-full h-full object-cover opacity-75"/>
                                <div class="absolute top-4 right-4">
                                    {% if hunt.status == 'closed' %}
                                        <span class="bg-gray-600 text-white text-xs font-semibold px-3 py-1 rounded-full flex items-center space-x-1">
                                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd"
                                                      d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z"
                                                      clip-rule="evenodd"></path>
                                            </svg>
                                            <span>Fermée</span>
                                        </span>
                                    {% elseif hunt.status == 'opened' %}
                                        <span class="bg-green-600 text-white text-xs font-semibold px-3 py-1 rounded-full flex items-center space-x-1">
                                            <svg class="w-3 h-3 animate-pulse" fill="currentColor" viewBox="0 0 20 20">
                                                <path fill-rule="evenodd"
                                                      d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z"
                                                      clip-rule="evenodd"></path>
                                            </svg>
                                            <span>Ouverte</span>
                                        </span>
                                    {% elseif hunt.status == 'draft' %}
                                        <span class="bg-orange-600 text-white text-xs font-semibold px-3 py-1 rounded-full flex items-center space-x-1 shadow-lg">
                                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
                                                <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.379 5.793L3 14.172V17h2.828l8.38-8.379-2.83-2.828z"></path>
                                            </svg>
                                            <span>Brouillon</span>
                                        </span>
                                    {% endif %}
                                </div>
                                <div class="absolute bottom-4 left-4 right-4">
                                    <h3 class="text-2xl font-bold text-white drop-shadow-lg">{{ hunt.title }}</h3>
                                </div>
                            </div>

                            <!-- Contenu -->
                            <div class="p-6">
                                <p class="text-gray-600 text-sm mb-4 line-clamp-2">
                                    {{ hunt.description|slice(0, 150) }} ...
                                </p>

                                <div class="flex items-center justify-between mb-4">
                                    <div class="flex items-center space-x-2 text-sm text-gray-600">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                                        </svg>
                                        <span>{{ hunt.riddles|length }} énigmes</span>
                                    </div>
                                    <div class="flex items-center space-x-2 text-sm text-gray-600">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                  d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"></path>
                                        </svg>
                                        <span>{{ hunt.designerTeam.name }}</span>
                                    </div>
                                </div>

                                <div class="flex items-center justify-between pt-4 border-t border-gray-200">
                                    <div class="flex items-center space-x-2">
                                        <div class="w-8 h-8 bg-gradient-to-br from-emerald-500 to-emerald-600 rounded-full flex items-center justify-center text-white text-xs font-bold">
                                            <img src="{{ path('_api_/users/{id}/picture_get', {id: hunt.owner.id}) }}"
                                                 alt="{{ hunt.owner.firstName }} {{ hunt.owner.lastName }}"
                                                 class="w-full h-full object-cover rounded-full"/>
                                        </div>
                                        <span class="text-sm text-gray-600">{{ hunt.owner.firstName }} {{ hunt.owner.lastName }}</span>
                                    </div>
                                    <span class="text-sm text-gray-500">Créée le {{ hunt.createdAt|date('d/m/Y') }} | Modifiée {{ hunt.updatedAt|ago }}</span>
                                </div>
                            </div>
                        </div>
                    </a>
                {% else %}
                    <!-- Message si aucune chasse -->
                    <div class="text-center py-16 bg-white rounded-2xl shadow-lg">
                        <svg class="w-24 h-24 text-gray-300 mx-auto mb-4" fill="none" stroke="currentColor"
                             viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
                        </svg>
                        <h3 class="text-xl font-semibold text-gray-600 mb-2">Aucune chasse pour le moment</h3>
                        <p class="text-gray-500 mb-6">Créez votre première chasse au trésor pour commencer l'aventure
                            !</p>
                        <a href="{{ path('app_designer_hunt_create') }}"
                           class="inline-flex items-center space-x-2 bg-gradient-to-r from-green-600 to-emerald-700 hover:from-green-700 hover:to-emerald-800 text-white font-semibold px-6 py-3 rounded-xl shadow-lg transform transition hover:scale-105 cursor-pointer">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M12 4v16m8-8H4"></path>
                            </svg>
                            <span>Créer ma première chasse</span>
                        </a>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
{% endblock %}
