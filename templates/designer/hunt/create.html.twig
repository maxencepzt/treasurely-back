{% extends 'base.html.twig' %}

{% block title %}Créer une chasse - Treasurely{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100">
        {{ include('designer/_partials/header.html.twig', {
            type: 'simple',
            title: 'Créer une chasse au trésor',
            subtitle: 'Concevez une nouvelle aventure pour vos joueurs',
            backUrl: designerTeamId ? path('app_designer_team_details', {id: designerTeamId}) : path('app_designer_hunt'),
            backTitle: 'Retour aux chasses',
        }) }}

        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            {{ include('designer/hunt/_form.html.twig', {
                mode: 'create',
                hunt: null,
                designerTeams: designerTeams,
                designerTeamId: designerTeamId|default(null),
                submitButtonText: 'Créer la chasse',
                cancelUrl: path('app_designer_hunt'),
            }) }}
        </div>
    </div>

    <!-- Toast global pour les notifications -->
    {{ include('_partials/toast.html.twig', {id: 'globalToast'}) }}

    {{ importmap('hunt-form') }}
    {{ importmap('riddle-manager') }}
{% endblock %}
