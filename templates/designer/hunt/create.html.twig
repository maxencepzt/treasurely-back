{% extends 'base.html.twig' %}

{% block title %}Créer une chasse - Treasurely{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100">
        <!-- Header -->
        <header class="bg-white shadow-md">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
                <div class="flex justify-between items-center">
                    <div class="flex items-center space-x-4">
                        <a href="{{ path('app_designer_hunt') }}" class="text-gray-600 hover:text-gray-800 transition cursor-pointer" title="Retour aux chasses">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path>
                            </svg>
                        </a>
                        <div>
                            <h1 class="text-2xl font-bold text-gray-800">Créer une chasse au trésor</h1>
                            <p class="text-sm text-gray-500">Concevez une nouvelle aventure pour vos joueurs</p>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <form class="space-y-8">
                <!-- Section: Informations de base -->
                <div class="bg-white rounded-2xl shadow-lg p-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center space-x-2">
                        <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <span>Informations de base</span>
                    </h2>

                    <div class="space-y-6">
                        <!-- Nom de la chasse -->
                        <div>
                            <label for="hunt_name" class="block text-sm font-semibold text-gray-700 mb-2">
                                Nom de la chasse <span class="text-red-500">*</span>
                            </label>
                            <input
                                type="text"
                                id="hunt_name"
                                name="hunt_name"
                                required
                                placeholder="Ex: Trésors du Vieux Lyon, Mystères du Musée..."
                                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-transparent transition"
                            />
                            <p class="mt-1 text-sm text-gray-500">Choisissez un nom captivant et descriptif</p>
                        </div>

                        <!-- Description courte -->
                        <div>
                            <label for="hunt_description" class="block text-sm font-semibold text-gray-700 mb-2">
                                Description courte <span class="text-red-500">*</span>
                            </label>
                            <textarea
                                id="hunt_description"
                                name="hunt_description"
                                rows="3"
                                required
                                placeholder="Une courte description qui apparaîtra dans la liste des chasses..."
                                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-transparent transition resize-none"
                            ></textarea>
                            <p class="mt-1 text-sm text-gray-500">Maximum 200 caractères</p>
                        </div>

                        <!-- Description détaillée -->
                        <div>
                            <label for="hunt_full_description" class="block text-sm font-semibold text-gray-700 mb-2">
                                Description détaillée
                            </label>
                            <textarea
                                id="hunt_full_description"
                                name="hunt_full_description"
                                rows="6"
                                placeholder="Décrivez en détail votre chasse au trésor, le contexte, l'histoire, ce que les joueurs vont découvrir..."
                                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-transparent transition resize-none"
                            ></textarea>
                            <p class="mt-1 text-sm text-gray-500">Maximum 1000 caractères</p>
                        </div>

                        <!-- Image de couverture (optionnel) -->
                        <div>
                            <label class="block text-sm font-semibold text-gray-700 mb-2">
                                Image de couverture
                            </label>
                            <div class="flex items-center space-x-4">
                                <div class="w-24 h-24 bg-gradient-to-br from-green-100 to-emerald-200 rounded-xl flex items-center justify-center text-4xl">
                                    🗺️
                                </div>
                                <div class="flex-1">
                                    <label for="hunt_image" class="cursor-pointer">
                                        <div class="border-2 border-dashed border-gray-300 rounded-xl px-6 py-4 hover:border-blue-500 transition">
                                            <div class="flex items-center space-x-3">
                                                <svg class="w-8 h-8 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                                                </svg>
                                                <div>
                                                    <p class="text-sm font-semibold text-gray-700">Cliquez pour uploader une image</p>
                                                    <p class="text-xs text-gray-500">GIF, PNG, JPG jusqu'à 5MB</p>
                                                </div>
                                            </div>
                                        </div>
                                        <input type="file" id="hunt_image" name="hunt_image" accept="image/*" class="hidden" />
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section: Configuration -->
                <div class="bg-white rounded-2xl shadow-lg p-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center space-x-2">
                        <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        <span>Configuration</span>
                    </h2>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <!-- Équipe -->
                        <div>
                            <label for="hunt_team" class="block text-sm font-semibold text-gray-700 mb-2">
                                Équipe <span class="text-red-500">*</span>
                            </label>
                            <select
                                id="hunt_team"
                                name="hunt_team"
                                required
                                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-transparent transition cursor-pointer"
                            >
                                <option value="">Sélectionnez une équipe</option>
                                <option value="1">Les Aventuriers</option>
                                <option value="2">Team Rocket</option>
                                <option value="3">Explorateurs IUT</option>
                            </select>
                            <p class="mt-1 text-sm text-gray-500">L'équipe propriétaire de cette chasse</p>
                        </div>

                        <!-- Type de chasse -->
                        <div>
                            <label for="hunt_type" class="block text-sm font-semibold text-gray-700 mb-2">
                                Type de chasse <span class="text-red-500">*</span>
                            </label>
                            <select
                                id="hunt_type"
                                name="hunt_type"
                                required
                                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-transparent transition cursor-pointer"
                            >
                                <option value="">Sélectionnez un type</option>
                                <option value="urbain">🏙️ Urbaine - Parcours en ville</option>
                                <option value="nature">🌳 Nature - Parcours en extérieur</option>
                                <option value="musee">🏛️ Musée - Parcours culturel</option>
                                <option value="interieur">🏠 Intérieur - Parcours en bâtiment</option>
                            </select>
                        </div>

                        <!-- Difficulté -->
                        <div>
                            <label for="hunt_difficulty" class="block text-sm font-semibold text-gray-700 mb-2">
                                Difficulté
                            </label>
                            <select
                                id="hunt_difficulty"
                                name="hunt_difficulty"
                                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-transparent transition cursor-pointer"
                            >
                                <option value="facile">⭐ Facile</option>
                                <option value="moyen" selected>⭐⭐ Moyen</option>
                                <option value="difficile">⭐⭐⭐ Difficile</option>
                                <option value="expert">⭐⭐⭐⭐ Expert</option>
                            </select>
                        </div>

                        <!-- Durée estimée -->
                        <div>
                            <label for="hunt_duration" class="block text-sm font-semibold text-gray-700 mb-2">
                                Durée estimée
                            </label>
                            <div class="flex items-center space-x-2">
                                <input
                                    type="number"
                                    id="hunt_duration"
                                    name="hunt_duration"
                                    min="15"
                                    step="15"
                                    placeholder="120"
                                    class="flex-1 px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-transparent transition"
                                />
                                <span class="text-sm text-gray-600 font-semibold">minutes</span>
                            </div>
                            <p class="mt-1 text-sm text-gray-500">Temps moyen pour compléter la chasse</p>
                        </div>
                    </div>

                    <!-- Options supplémentaires -->
                    <div class="mt-6 space-y-3">
                        <label class="flex items-center space-x-3 cursor-pointer">
                            <input type="checkbox" class="w-5 h-5 text-green-600 border-gray-300 rounded focus:ring-green-500 cursor-pointer" />
                            <span class="text-sm font-medium text-gray-700">Chasse publique (visible par tous les utilisateurs)</span>
                        </label>
                        <label class="flex items-center space-x-3 cursor-pointer">
                            <input type="checkbox" class="w-5 h-5 text-green-600 border-gray-300 rounded focus:ring-green-500 cursor-pointer" />
                            <span class="text-sm font-medium text-gray-700">Autoriser les participations en équipe</span>
                        </label>
                        <label class="flex items-center space-x-3 cursor-pointer">
                            <input type="checkbox" class="w-5 h-5 text-green-600 border-gray-300 rounded focus:ring-green-500 cursor-pointer" checked />
                            <span class="text-sm font-medium text-gray-700">Activer le classement des participants</span>
                        </label>
                    </div>
                </div>

                <!-- Section: Énigmes -->
                <div class="bg-white rounded-2xl shadow-lg p-6">
                    <div class="flex items-center justify-between mb-6">
                        <h2 class="text-xl font-bold text-gray-800 flex items-center space-x-2">
                            <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <span>Énigmes (<span id="riddles_count">0</span>)</span>
                        </h2>
                        <button type="button" id="add_riddle_btn" class="bg-purple-600 hover:bg-purple-700 text-white font-semibold px-4 py-2 rounded-lg shadow transform transition hover:scale-105 flex items-center space-x-2 cursor-pointer">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
                            </svg>
                            <span>Ajouter une énigme</span>
                        </button>
                    </div>

                    <!-- Message si aucune énigme -->
                    <div id="no_riddles_message" class="p-8 text-center bg-gray-50 rounded-xl border-2 border-dashed border-gray-200">
                        <svg class="w-16 h-16 text-gray-300 mx-auto mb-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                        </svg>
                        <p class="text-gray-500 font-medium mb-2">Aucune énigme pour le moment</p>
                        <p class="text-gray-400 text-sm">Cliquez sur "Ajouter une énigme" pour commencer à créer votre parcours</p>
                    </div>

                    <!-- Liste des énigmes -->
                    <div id="riddles_list" class="hidden space-y-3">
                        <!-- Les énigmes seront ajoutées dynamiquement ici -->
                    </div>
                </div>

                <!-- Section: Localisation -->
                <div class="bg-white rounded-2xl shadow-lg p-6">
                    <h2 class="text-xl font-bold text-gray-800 mb-6 flex items-center space-x-2">
                        <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        </svg>
                        <span>Localisation</span>
                    </h2>

                    <div class="space-y-4">
                        <div>
                            <label for="hunt_city" class="block text-sm font-semibold text-gray-700 mb-2">
                                Ville
                            </label>
                            <input
                                type="text"
                                id="hunt_city"
                                name="hunt_city"
                                placeholder="Lyon, Paris, Marseille..."
                                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-transparent transition"
                            />
                        </div>

                        <div>
                            <label for="hunt_address" class="block text-sm font-semibold text-gray-700 mb-2">
                                Point de départ (optionnel)
                            </label>
                            <input
                                type="text"
                                id="hunt_address"
                                name="hunt_address"
                                placeholder="Place Bellecour, 69002 Lyon"
                                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-green-500 focus:border-transparent transition"
                            />
                            <p class="mt-1 text-sm text-gray-500">Indiquez où les joueurs doivent commencer la chasse</p>
                        </div>

                        <!-- Carte (placeholder) -->
                        <div class="h-64 bg-gradient-to-br from-gray-100 to-gray-200 rounded-xl flex items-center justify-center border-2 border-dashed border-gray-300">
                            <div class="text-center">
                                <svg class="w-16 h-16 text-gray-400 mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
                                </svg>
                                <p class="text-gray-500 text-sm">Carte interactive (à venir)</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Boutons d'action -->
                <div class="flex items-center justify-between bg-white rounded-2xl shadow-lg p-6">
                    <a href="{{ path('app_designer_hunt') }}" class="text-gray-600 hover:text-gray-800 font-semibold px-6 py-3 rounded-xl hover:bg-gray-100 transition cursor-pointer">
                        Annuler
                    </a>
                    <div class="flex items-center space-x-3">
                        <button type="submit" class="bg-white border border-gray-300 hover:border-gray-400 px-8 py-3 rounded-xl shadow-lg transform transition hover:scale-105 cursor-pointer flex items-center space-x-2 font-semibold hover:bg-gray-100">
                            <span class="text-gray-600 hover:text-gray-800">
                                Enregistrer le brouillon
                            </span>
                        </button>
                        <button type="submit" class="bg-gradient-to-r from-green-600 to-emerald-700 hover:from-green-700 hover:to-emerald-800 text-white font-semibold px-8 py-3 rounded-xl shadow-lg transform transition hover:scale-105 cursor-pointer flex items-center space-x-2">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                            </svg>
                            <span>Créer la chasse</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Modal de création/édition d'énigme -->
    <div id="riddle_modal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-3xl w-full max-h-[90vh] overflow-y-auto">
            <div class="sticky top-0 bg-white border-b border-gray-200 px-6 py-4 flex items-center justify-between rounded-t-2xl">
                <h3 id="riddle_modal_title" class="text-2xl font-bold text-gray-800">Ajouter une énigme</h3>
                <button type="button" id="close_riddle_modal" class="text-gray-400 hover:text-gray-600 transition">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>

            <form id="riddle_form" class="p-6 space-y-6">
                <!-- Informations de base -->
                <div class="space-y-4">
                    <div>
                        <label for="riddle_title" class="block text-sm font-semibold text-gray-700 mb-2">
                            Titre de l'énigme <span class="text-red-500">*</span>
                        </label>
                        <input
                            type="text"
                            id="riddle_title"
                            required
                            maxlength="20"
                            placeholder="Ex: Trouve le monument"
                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent transition"
                        />
                    </div>

                    <div>
                        <label for="riddle_description" class="block text-sm font-semibold text-gray-700 mb-2">
                            Description de l'énigme <span class="text-red-500">*</span>
                        </label>
                        <textarea
                            id="riddle_description"
                            required
                            maxlength="1000"
                            rows="4"
                            placeholder="Décrivez l'énigme que les joueurs devront résoudre..."
                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent transition resize-none"
                        ></textarea>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label for="riddle_difficulty" class="block text-sm font-semibold text-gray-700 mb-2">
                                Difficulté <span class="text-red-500">*</span>
                            </label>
                            <select
                                id="riddle_difficulty"
                                required
                                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent transition cursor-pointer"
                            >
                                <option value="1">⭐ Facile</option>
                                <option value="2" selected>⭐⭐ Moyen</option>
                                <option value="3">⭐⭐⭐ Difficile</option>
                            </select>
                        </div>

                        <div>
                            <label for="riddle_type" class="block text-sm font-semibold text-gray-700 mb-2">
                                Type d'énigme <span class="text-red-500">*</span>
                            </label>
                            <select
                                id="riddle_type"
                                required
                                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent transition cursor-pointer"
                            >
                                <option value="text">✍️ Réponse texte</option>
                                <option value="gps">📍 Localisation GPS</option>
                                <option value="mcq">☑️ QCM</option>
                                <option value="qr">📱 QR Code</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- Champs spécifiques : Réponse texte -->
                <div id="text_fields" class="riddle-type-fields space-y-4">
                    <div class="bg-blue-50 border border-blue-200 rounded-xl p-4">
                        <h4 class="font-semibold text-gray-800 mb-3">Réponse attendue <span class="text-red-500">*</span></h4>
                        <input
                            type="text"
                            id="text_answer"
                            maxlength="100"
                            placeholder="La réponse correcte"
                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent transition"
                        />
                        <p class="mt-2 text-sm text-gray-500">Les joueurs devront saisir cette réponse exactement</p>
                    </div>
                </div>

                <!-- Champs spécifiques : GPS -->
                <div id="gps_fields" class="riddle-type-fields hidden space-y-4">
                    <div class="bg-green-50 border border-green-200 rounded-xl p-4">
                        <h4 class="font-semibold text-gray-800 mb-3">Coordonnées GPS <span class="text-red-500">*</span></h4>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label for="gps_latitude" class="block text-sm font-medium text-gray-700 mb-1">
                                    Latitude <span class="text-red-500">*</span>
                                </label>
                                <input
                                    type="number"
                                    id="gps_latitude"
                                    step="0.000001"
                                    placeholder="45.764043"
                                    class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent transition"
                                />
                            </div>
                            <div>
                                <label for="gps_longitude" class="block text-sm font-medium text-gray-700 mb-1">
                                    Longitude <span class="text-red-500">*</span>
                                </label>
                                <input
                                    type="number"
                                    id="gps_longitude"
                                    step="0.000001"
                                    placeholder="4.835659"
                                    class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent transition"
                                />
                            </div>
                        </div>
                        <p class="mt-2 text-sm text-gray-500">Les joueurs devront se rendre à cet endroit précis</p>
                    </div>
                </div>

                <!-- Champs spécifiques : QCM -->
                <div id="mcq_fields" class="riddle-type-fields hidden space-y-4">
                    <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-4">
                        <div class="flex items-center justify-between mb-3">
                            <h4 class="font-semibold text-gray-800">Choix de réponses <span class="text-red-500">*</span></h4>
                            <button type="button" id="add_mcq_choice" class="text-sm bg-yellow-600 hover:bg-yellow-700 text-white px-3 py-1 rounded-lg transition">
                                + Ajouter un choix
                            </button>
                        </div>
                        <p class="text-sm text-gray-600 mb-3">Cochez au moins une bonne réponse</p>
                        <div id="mcq_choices_container" class="space-y-2">
                            <!-- Les choix seront ajoutés dynamiquement -->
                        </div>
                    </div>
                </div>

                <!-- Champs spécifiques : QR Code -->
                <div id="qr_fields" class="riddle-type-fields hidden space-y-4">
                    <div class="bg-purple-50 border border-purple-200 rounded-xl p-4">
                        <h4 class="font-semibold text-gray-800 mb-3">Code QR <span class="text-red-500">*</span></h4>
                        <input
                            type="text"
                            id="qr_code"
                            maxlength="20"
                            placeholder="CODE123"
                            class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent transition"
                        />
                        <p class="mt-2 text-sm text-gray-500">Le code que les joueurs devront scanner</p>
                    </div>
                </div>

                <!-- Boutons d'action -->
                <div class="flex items-center justify-end space-x-3 pt-4 border-t border-gray-200">
                    <button type="button" id="close_riddle_modal_btn" class="text-gray-600 hover:text-gray-800 font-semibold px-6 py-3 rounded-xl hover:bg-gray-100 transition">
                        Annuler
                    </button>
                    <button type="button" id="save_riddle_btn" class="bg-gradient-to-r from-purple-600 to-indigo-700 hover:from-purple-700 hover:to-indigo-800 text-white font-semibold px-8 py-3 rounded-xl shadow-lg transform transition hover:scale-105">
                        Enregistrer l'énigme
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script src="{{ asset('js/hunt-create.js') }}"></script>
{% endblock %}
