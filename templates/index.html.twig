{% extends 'base.html.twig' %}
{% import 'designer/_partials/macros.html.twig' as ui %}
{% import 'designer/_partials/icons.html.twig' as icons %}

{% block title %}Treasurely - Accueil{% endblock %}

{% block body %}
    <div class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 flex items-center justify-center p-6">
        <div class="{{ ui.card('p-8 max-w-md w-full space-y-8 relative') }}">
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('api_doc') }}" target="_blank" class="absolute top-4 right-4 w-10 h-10 rounded-xl flex items-center justify-center text-slate-500 hover:text-slate-800 hover:bg-slate-100 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-green-500" title="Documentation de l'API" aria-label="Documentation de l'API">
                    {{ ui.icon(icons.path('text')) }}
                </a>
            {% endif %}

            <div class="text-center">
                <div class="mx-auto mb-4 w-16 h-16 rounded-2xl bg-green-100 text-green-600 flex items-center justify-center">
                    {{ ui.icon(icons.path('shield'), 'w-8 h-8') }}
                </div>
                <h1 class="text-3xl font-bold text-slate-800 mb-1">Treasurely</h1>
                <p class="text-slate-500">Créez et gérez vos chasses au trésor</p>
            </div>

            <div class="space-y-3">
                {% if is_granted('ROLE_ADMIN') %}
                    <a href="{{ path('admin') }}" class="{{ ui.btn('blue', 'lg') }} w-full">
                        {{ ui.icon(icons.path('cog')) }}
                        <span>Accéder à l'administration</span>
                    </a>
                {% endif %}
                <a href="{{ path('app_designer_dashboard') }}" class="{{ ui.btn('primary', 'lg') }} w-full">
                    {{ ui.icon(icons.path('chest')) }}
                    <span>Accéder à la conception</span>
                </a>
                <a href="{{ path('sso_logout') }}" class="{{ ui.btn('secondary', 'lg') }} w-full">
                    {{ ui.icon(icons.path('arrow_left')) }}
                    <span>Retourner sur le site</span>
                </a>
            </div>

            {% if app.user %}
                <p class="text-center text-sm text-slate-500 pt-4 border-t border-slate-100">
                    Connecté en tant que <span class="font-semibold text-slate-700">{{ app.user.nickname }}</span>
                </p>
            {% endif %}
        </div>
    </div>
{% endblock %}
