{
  "type": "project",
  "name": "treasurely/sae5-01-back",
  "description": "Backend Symfony de l'application mobile Treasurely, une application de chasse au trésor avec des énigmes.",
  "license": "proprietary",
  "minimum-stability": "stable",
  "prefer-stable": true,
  "require": {
    "php": ">=8.3",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-intl": "*",
    "api-platform/doctrine-orm": "^4.2",
    "api-platform/symfony": "^4.2",
    "doctrine/dbal": "^3",
    "doctrine/doctrine-bundle": "^2.18",
    "doctrine/doctrine-migrations-bundle": "^3.4",
    "doctrine/orm": "^3.5",
    "easycorp/easyadmin-bundle": "^4.26",
    "gesdinet/jwt-refresh-token-bundle": "^1.5",
    "lexik/jwt-authentication-bundle": "^3.1",
    "nelmio/cors-bundle": "^2.5",
    "phpdocumentor/reflection-docblock": "^5.6",
    "phpstan/phpdoc-parser": "^2.3",
    "stof/doctrine-extensions-bundle": "^1.14",
    "symfony/asset": "7.3.*",
    "symfony/asset-mapper": "7.3.*",
    "symfony/console": "7.3.*",
    "symfony/doctrine-messenger": "7.3.*",
    "symfony/dotenv": "7.3.*",
    "symfony/expression-language": "7.3.*",
    "symfony/flex": "^2",
    "symfony/form": "7.3.*",
    "symfony/framework-bundle": "7.3.*",
    "symfony/http-client": "7.3.*",
    "symfony/intl": "7.3.*",
    "symfony/mailer": "7.3.*",
    "symfony/mime": "7.3.*",
    "symfony/monolog-bundle": "^3.0",
    "symfony/notifier": "7.3.*",
    "symfony/process": "7.3.*",
    "symfony/property-access": "7.3.*",
    "symfony/property-info": "7.3.*",
    "symfony/runtime": "7.3.*",
    "symfony/security-bundle": "7.3.*",
    "symfony/serializer": "7.3.*",
    "symfony/stimulus-bundle": "^2.30",
    "symfony/string": "7.3.*",
    "symfony/translation": "7.3.*",
    "symfony/twig-bundle": "7.3.*",
    "symfony/ux-turbo": "^2.30",
    "symfony/validator": "7.3.*",
    "symfony/web-link": "7.3.*",
    "symfony/workflow": "7.3.*",
    "symfony/yaml": "7.3.*",
    "symfonycasts/tailwind-bundle": "^0.11.1",
    "twig/extra-bundle": "^2.12|^3.0",
    "twig/intl-extra": "^3.22",
    "twig/twig": "^2.12|^3.0"
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true,
      "phpro/grumphp": true,
      "phpstan/extension-installer": true,
      "symfony/flex": true,
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "replace": {
    "symfony/polyfill-ctype": "*",
    "symfony/polyfill-iconv": "*",
    "symfony/polyfill-php72": "*",
    "symfony/polyfill-php73": "*",
    "symfony/polyfill-php74": "*",
    "symfony/polyfill-php80": "*",
    "symfony/polyfill-php81": "*",
    "symfony/polyfill-php82": "*"
  },
  "scripts": {
    "auto-scripts": {
      "cache:clear": "symfony-cmd",
      "assets:install %PUBLIC_DIR%": "symfony-cmd",
      "importmap:install": "symfony-cmd"
    },
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "post-update-cmd": [
      "@auto-scripts"
    ],
    "start" : [
      "Composer\\Config::disableProcessTimeout",
      "symfony serve"
    ],
    "test:csfixer" : [
      "php-cs-fixer fix --dry-run"
    ],
    "fix:csfixer": [
      "php-cs-fixer fix"
    ],
    "test:phpstan": [
      "php vendor/bin/codecept build",
      "phpstan analyse"
    ],
    "test:twig" : [
      "twig-cs-fixer lint"
    ],
    "fix:twig" : [
      "twig-cs-fixer lint --fix"
    ],
    "test:yaml" : [
      "php bin/console lint:yaml config"
    ],
    "test:codeception" : [
      "php vendor/bin/codecept clean",
      "APP_ENV=test php bin/console doctrine:database:drop --force",
      "APP_ENV=test php bin/console doctrine:database:create",
      "APP_ENV=test php bin/console doctrine:schema:create --quiet",
      "php vendor/bin/codecept run --no-artifacts"
    ],
    "test:codeception_w": [
      "php vendor/bin/codecept clean",
      "php bin/console doctrine:database:drop --force --env=test",
      "php bin/console doctrine:database:create --env=test",
      "php bin/console doctrine:schema:create --quiet --env=test",
      "php vendor/bin/codecept run --no-artifacts"
    ],
    "test" : [
      "@test:csfixer",
      "@test:phpstan",
      "@test:twig",
      "@test:yaml",
      "@test:codeception"
    ],
    "fix" : [
      "@fix:csfixer",
      "@fix:twig"
    ],
    "db" : [
      "php bin/console doctrine:database:drop --force --if-exists",
      "php bin/console doctrine:database:create --if-not-exists",
      "php bin/console doctrine:migrations:migrate --no-interaction",
      "php bin/console doctrine:fixtures:load --no-interaction"
    ],
    "jwt:generate": [
      "php bin/console lexik:jwt:generate-keypair"
    ],
    "openapi:generate": "bin/console api:openapi:export --spec-version=3.0.0 --yaml --output=openapi.yaml"
  },
  "scripts-descriptions": {
    "fix:csfixer": "Corrige le code PHP avec PHP CS Fixer",
    "fix:twig": "Corrige le code Twig avec Twig CS Fixer",
    "test:csfixer": "Teste le code PHP avec PHP CS Fixer",
    "test:phpstan": "Teste le code PHP avec PhpStan",
    "test:twig": "Teste le code Twig avec Twig CS Fixer",
    "test:yaml": "Vérifie les fichiers dans le répertoire config",
    "test:codeception": "Lance les tests fonctionnels avec Codeception",
    "test": "Lance tous les tests",
    "fix": "Lance tous les scripts de correction",
    "db": "Supprime, crée, migre et charge les fixtures dans la base de données",
    "start": "Démarre le serveur",
    "jwt:generate": "Génère une nouvelle paire de clés pour JWT"
  },
  "conflict": {
    "symfony/symfony": "*"
  },
  "extra": {
    "symfony": {
      "allow-contrib": false,
      "require": "7.3.*"
    }
  },
  "require-dev": {
    "codeception/codeception": "^5.3",
    "codeception/module-asserts": "^3.2",
    "codeception/module-doctrine": "^3.2",
    "codeception/module-rest": "^3.4",
    "codeception/module-symfony": "^3.7",
    "doctrine/doctrine-fixtures-bundle": "^4.1",
    "php-cs-fixer/shim": "^3.88",
    "phpro/grumphp": "^2.15",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-doctrine": "^2.0",
    "phpstan/phpstan-symfony": "^2.0",
    "phpunit/phpunit": "^12.3",
    "symfony/browser-kit": "7.3.*",
    "symfony/css-selector": "7.3.*",
    "symfony/debug-bundle": "7.3.*",
    "symfony/maker-bundle": "^1.0",
    "symfony/stopwatch": "7.3.*",
    "symfony/web-profiler-bundle": "7.3.*",
    "vincentlanglet/twig-cs-fixer": "^3.10",
    "zenstruck/foundry": "^2.7"
  }
}
